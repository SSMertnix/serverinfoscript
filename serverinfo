        j_str public_ipv4 "$NET_PUBLIC_IP"
        j_str public_ip_source "$NET_PUBLIC_SRC"
        j_str gateway "$NET_GATEWAY"
        j_open_arr ipv4_addresses
        for ip in "${NET_IPV4_ALL[@]}"; do
