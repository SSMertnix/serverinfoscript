        j_bytes used "$MEM_USED"
        j_bytes available "$MEM_AVAILABLE"
        j_bytes free "$MEM_FREE"
        j_bytes cached "$MEM_CACHED"
        j_pct usage_percent "$MEM_PCT_X10"
        j_open swap
        j_bytes total "$SWAP_TOTAL"
        j_bytes used "$SWAP_USED"
        j_bytes free "$SWAP_FREE"
        j_pct usage_percent "$SWAP_PCT_X10"
        j_close
        j_close
    fi

    if want storage; then
        j_open storage
        j_str device_type "$ROOT_KIND"
        j_str disk_model "$ROOT_MODEL"
        j_str layout "$ROOT_LAYOUT"
        j_str mount "/"
        j_str filesystem "$ROOT_FSTYPE"
        j_str source "$ROOT_SRC"
        j_bytes total "$ROOT_SIZE"
        j_bytes used "$ROOT_USED"
        j_bytes free "$ROOT_AVAIL"
        j_pct usage_percent "$ROOT_PCT_X10"
        j_open_arr filesystems
        for entry in "${FS_LIST[@]}"; do
            IFS=$FS_SEP read -r m t s u a p src <<< "$entry"
            j_open ""
            j_str mount "$m"
            j_str filesystem "$t"
            j_str source "$src"
            j_bytes total "$s"
            j_bytes used "$u"
            j_bytes free "$a"
            j_pct usage_percent "$p"
            j_close
        done
        j_close_arr
        j_close
    fi

    if want network; then
        j_open network
        j_str interface "$NET_IFACE"
        j_str state "$NET_STATE"
        j_str link_speed "$NET_SPEED"
        j_num mtu "$NET_MTU"
        j_str ipv4 "$NET_IPV4"
        j_str ipv4_cidr "$NET_IPV4_CIDR"
