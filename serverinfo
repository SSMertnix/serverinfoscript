render_network() {
    local detail=${1:-} v c entry name st ip
    print_section "NETWORK"
    if [[ -z $NET_IFACE ]]; then
        print_kv "Status" "NO NETWORK" "$C_RED"
        return 0
    fi
    print_kv "Interface" "$NET_IFACE" "$C_CYAN"
    case ${NET_STATE,,} in up) c=$C_GREEN ;; down) c=$C_RED ;; *) c=$C_YELLOW ;; esac
    print_kv "State" "${NET_STATE^^}" "$c$C_BOLD"
    print_kv "Link Speed" "${NET_SPEED:-N/A}"
    v=${NET_IPV4:-N/A}
    (( NET_IPV4_EXTRA > 0 )) && v+="  $C_GRAY(+$NET_IPV4_EXTRA more)$C_RST"
    print_kv "IPv4" "$v"
    print_kv "IPv6" "${NET_IPV6:-N/A}"
    if [[ -n $NET_PUBLIC_IP ]]; then
        print_kv "Public IP" "$NET_PUBLIC_IP" "$C_CYAN"
    elif [[ -n $NET_IPV4 ]]; then
        print_kv "Public IP" "N/A  (private address / NAT)"
    else
        print_kv "Public IP" "N/A"
    fi
    print_kv "Gateway" "${NET_GATEWAY:-N/A}"
    print_kv "DNS" "${NET_DNS:-N/A}"
    human_bytes "$NET_RX"; print_kv "RX" "$REPLY"
    human_bytes "$NET_TX"; print_kv "TX" "$REPLY"
    [[ $detail == detail ]] || return 0
    print_kv "MTU" "${NET_MTU:-N/A}"
    if (( NET_IPV4_EXTRA > 0 )); then
        local i shown=0
        for (( i = 1; i < ${#NET_IPV4_ALL[@]}; i++ )); do
            if (( shown == 8 )); then
                print_kv "" "$C_GRAY(+$(( ${#NET_IPV4_ALL[@]} - 1 - shown )) more)$C_RST" ""
                break
            fi
            if (( shown == 0 )); then print_kv "Extra IPv4" "${NET_IPV4_ALL[i]}"; else print_kv "" "${NET_IPV4_ALL[i]}"; fi
            shown=$(( shown + 1 ))
        done
    fi
    (( ${#NET_OTHER[@]} > 0 )) || return 0
    printf '\n %s%-18s %-10s %s%s\n' "$C_GRAY" "Interface" "State" "IPv4" "$C_RST"
    for entry in "${NET_OTHER[@]}"; do
        IFS=$FS_SEP read -r name st ip <<< "$entry"
        case $st in up) c=$C_GREEN ;; down) c=$C_RED ;; *) c=$C_GRAY ;; esac
        printf ' %-18s %s%-10s%s %s\n' "${name:0:18}" "$c" "${st^^}" "$C_RST" "${ip:--}"
    done
}

