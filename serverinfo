# ============================================================================
# MAIN
# ============================================================================
readonly CPU_WINDOW_US=400000
declare -A WANT=()

want() { [[ -n ${WANT[all]:-} || -n ${WANT[$1]:-} ]]; }

collect_data() {
    local cpu=0 mem=0 disk=0 net=0 docker=0 ptero=0 status=0
    want cpu && cpu=1
    want memory && mem=1
    want storage && disk=1
    want network && net=1
    want docker && docker=1
    want pterodactyl && ptero=1 docker=1
    if want status; then
        status=1 cpu=1 mem=1 disk=1 docker=1 ptero=1
    fi
    (( docker || ptero )) && query_services wings docker nginx apache2 pteroq
    get_system_info
    (( cpu )) && get_cpu_info
    (( mem )) && get_memory_info
    (( disk )) && get_disk_info
    if (( net )); then
        get_network_info
        [[ -z ${WANT[all]:-} ]] && get_other_interfaces
    fi
    (( docker )) && get_docker_info
    (( ptero )) && get_pterodactyl_info
    if (( cpu )); then
        # dedicated quiet window: serverinfo's own work is not counted as load
        cpu_sample
        measure_cpu_usage "$CPU_WINDOW_US"
    fi
    (( status )) && get_health_status
    return 0
}

render_report() {
    if [[ -n ${WANT[all]:-} ]]; then
        print_header full
    else
        print_header compact
    fi
    want system && render_system
    want cpu && render_cpu
    want memory && render_memory
    want storage && render_storage
    if want network; then
        if [[ -n ${WANT[all]:-} ]]; then render_network; else render_network detail; fi
    fi
    want docker && render_docker
    want pterodactyl && render_pterodactyl
    want status && render_status
    print_footer
}

main() {
    local mode=report json=0 a i s
    local -a args=() sections=()
    for a in "$@"; do
        if [[ $a =~ ^-[A-Za-z]{2,}$ ]]; then
            for (( i = 1; i < ${#a}; i++ )); do args+=("-${a:i:1}"); done
        else
            args+=("$a")
        fi
    done
    set -- "${args[@]}"
    load_config

    while (( $# > 0 )); do
        case $1 in
            -h|--help)               mode=help ;;
            -v|-V|--version)         mode=version ;;
            -l|--live)               mode=live ;;
            -j|--json)               json=1 ;;
            --system)                sections+=(system) ;;
            -c|--cpu)                sections+=(cpu) ;;
            -r|--ram|--memory|--mem) sections+=(memory) ;;
            -d|--disk|--storage)     sections+=(storage) ;;
            -n|--network|--net)      sections+=(network) ;;
            -p|--pterodactyl|--ptero) sections+=(pterodactyl) ;;
            --docker)                sections+=(docker) ;;
            -s|--status|--health)    sections+=(status) ;;
            --no-color|--no-colour)  COLOR_MODE=never ;;
            --color|--colour)        COLOR_MODE=always ;;
            --public-ip)             CFG_PUBLIC_IP_LOOKUP=yes ;;
            -i|--interval|--interval=*)
                if [[ $1 == --interval=* ]]; then s=${1#*=}; else s=${2:-}; shift; fi
                if [[ $s =~ ^[0-9]{1,2}$ ]] && (( 10#$s >= 1 && 10#$s <= 60 )); then
                    CFG_LIVE_INTERVAL=$(( 10#$s ))
                else
                    msg_err "--interval expects a number of seconds between 1 and 60"
                    return 2
                fi
                ;;
            --uninstall)             shift; do_uninstall "$@"; return $? ;;
            --completion)            print_completion; return 0 ;;
            --print-config)          print_default_config; return 0 ;;
            *)
                msg_err "unknown option: $1"
                echo "Try 'serverinfo --help' for the list of options." >&2
                return 2
                ;;
        esac
        shift
    done

    case $mode in
        help)
            setup_colors
            print_help
            return 0
            ;;
        version)
            printf '%s %s\n' "$SI_NAME" "$SI_VERSION"
            return 0
            ;;
        live)
            if (( json )); then
                msg_err "--live cannot be combined with --json"
                return 2
            fi
            setup_colors
            setup_layout
            live_mode
            return $?
            ;;
    esac

    (( json )) && COLOR_MODE=never
    setup_colors
    setup_layout
    if (( ${#sections[@]} == 0 )); then
        WANT[all]=1
    else
        for s in "${sections[@]}"; do WANT[$s]=1; done
    fi
    collect_data
    if (( json )); then
        json_mode
    else
        render_report
    fi
}

main "$@"
exit $?
