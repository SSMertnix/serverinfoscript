# ============================================================================
# JSON OUTPUT (pretty-printed, never colored; unknown values are null)
# ============================================================================
J_OUT="" J_DEPTH=0 J_FIRST=1

j_prefix() {
    if (( J_DEPTH > 0 )); then
        (( J_FIRST )) || J_OUT+=","
        printf -v REPLY '\n%*s' $(( J_DEPTH * 2 )) ''
        J_OUT+=$REPLY
    fi
    J_FIRST=0
    if [[ -n $1 ]]; then
        json_escape "$1"
        J_OUT+="$REPLY: "
    fi
}
j_open()      { j_prefix "$1"; J_OUT+='{'; J_DEPTH=$(( J_DEPTH + 1 )); J_FIRST=1; }
j_open_arr()  { j_prefix "$1"; J_OUT+='['; J_DEPTH=$(( J_DEPTH + 1 )); J_FIRST=1; }
j_end() {
    J_DEPTH=$(( J_DEPTH - 1 ))
    if (( ! J_FIRST )); then
        printf -v REPLY '\n%*s' $(( J_DEPTH * 2 )) ''
        J_OUT+=$REPLY
    fi
    J_OUT+=$1
    J_FIRST=0
}
j_close()     { j_end '}'; }
j_close_arr() { j_end ']'; }
j_raw()  { j_prefix "$1"; J_OUT+=$2; }
j_str()  { json_escape "$2"; j_raw "$1" "$REPLY"; }
j_bool() { if (( ${2:-0} )); then j_raw "$1" true; else j_raw "$1" false; fi; }
j_pct()  { fmt_x10 "${2:-0}"; j_raw "$1" "$REPLY"; }
j_num() {
    if [[ $2 =~ ^-?(0|[1-9][0-9]*)(\.[0-9]+)?$ ]]; then
        j_raw "$1" "$2"
    elif is_uint "$2"; then
        j_raw "$1" $(( 10#$2 ))
    else
        j_raw "$1" null
    fi
}
# j_bytes KEY BYTES - "<key>_bytes": number and "<key>": human readable
j_bytes() {
    j_num "${1}_bytes" "$2"
    human_bytes "$2" || REPLY=""
    j_str "$1" "$REPLY"
}

json_mode() {
    local ts entry m t s u a p src name st ip dns
    printf -v ts '%(%Y-%m-%dT%H:%M:%S%z)T' "$NOW_EPOCH"
    ts="${ts:0:22}:${ts:22:2}"
    J_OUT="" J_DEPTH=0 J_FIRST=1
    j_open ""
    j_open elitehost
    j_str tool "serverinfo"
    j_str name "$SI_NAME"
    j_str version "$SI_VERSION"
    j_str generated_at "$ts"
    j_close

    if want system; then
        j_open system
        j_str os "$SYS_OS"
        j_str os_id "$SYS_OS_ID"
        j_str version_id "$SYS_OS_VERSION_ID"
        j_str debian_version "$SYS_DEBIAN_VERSION"
        j_str codename "$SYS_CODENAME"
        j_str kernel "$SYS_KERNEL"
        j_str architecture "$SYS_ARCH"
        j_str hostname "$SYS_HOSTNAME"
        j_num uptime_seconds "$SYS_UPTIME_S"
        format_duration "$SYS_UPTIME_S"
        j_str uptime "$REPLY"
        j_str boot_time "$SYS_BOOT_TIME"
        j_str datetime "$SYS_DATETIME"
        j_str timezone "$SYS_TIMEZONE"
