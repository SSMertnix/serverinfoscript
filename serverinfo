# pad TEXT WIDTH -> REPLY (character-aware right padding)
pad() {
    local n=$(( $2 - ${#1} ))
    (( n < 0 )) && n=0
    printf -v REPLY '%s%*s' "$1" "$n" ''
}

# load_color LOAD -> REPLY (color by load per logical CPU)
load_color() {
    local l=$1 whole frac per
    whole=${l%%.*} frac=${l#*.}
    [[ $l == *.* ]] || frac=0
    frac=${frac:0:2}
    while (( ${#frac} < 2 )); do frac="${frac}0"; done
    if ! is_uint "$whole" || ! is_uint "$frac"; then
        REPLY=$C_WHITE
        return
    fi
    local t=$CPU_THREADS
    if ! is_uint "$t" || (( t == 0 )); then t=1; fi
    per=$(( (10#$whole * 100 + 10#$frac) / t ))
    if (( per >= 100 )); then REPLY=$C_RED; elif (( per >= 70 )); then REPLY=$C_YELLOW; else REPLY=$C_GREEN; fi
}

# temp_value CELSIUS -> REPLY (colored "52°C" or N/A)
temp_value() {
    if ! is_uint "$1"; then
        REPLY="${C_GRAY}N/A${C_RST}"
        return
    fi
    local c=$C_GREEN
    (( $1 >= 70 )) && c=$C_YELLOW
    (( $1 >= 85 )) && c=$C_RED
    REPLY="$c$1°C$C_RST"
}

