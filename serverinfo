        j_num paused "$DOCKER_PAUSED"
        j_num images "$DOCKER_IMAGES"
        j_str storage_driver "$DOCKER_DRIVER"
        j_str root_dir "$DOCKER_ROOT"
        j_close
    fi

    if want pterodactyl; then
        j_open pterodactyl
        j_bool detected "$PTERO_DETECTED"
        j_num servers "$PTERO_SERVERS"
        j_num online "$PTERO_ONLINE"
        j_num offline "$PTERO_OFFLINE"
        j_num starting "$PTERO_STARTING"
        j_num suspended "$PTERO_SUSPENDED"
        j_str source "$PTERO_SOURCE"
        j_str note "$PTERO_NOTE"
        j_open panel
        j_bool detected "$PANEL_DETECTED"
        j_str path "$PANEL_PATH"
        j_str version "$PANEL_VERSION"
        j_str web_server "$PANEL_WEBSERVER"
        j_bool database_connected "$PANEL_DB_OK"
        j_num total_servers "$PANEL_SERVERS"
        j_num nodes "$PANEL_NODES"
        j_num suspended_servers "$PANEL_SUSPENDED"
        j_close
        j_open wings
        j_bool installed "$WINGS_INSTALLED"
        j_str status "$WINGS_STATE"
        j_str version "$WINGS_VERSION"
        j_num api_port "$WINGS_API_PORT"
        case $WINGS_API_TLS in
            true) j_raw api_tls true ;;
            false) j_raw api_tls false ;;
            *) j_raw api_tls null ;;
        esac
        j_num sftp_port "$WINGS_SFTP_PORT"
        (( WINGS_INSTALLED )) && j_str data_dir "$WINGS_DATA_DIR"
        j_close
        j_close
    fi

    if want status; then
        j_open health
        j_str cpu "$HEALTH_CPU"
        j_str ram "$HEALTH_RAM"
        j_str storage "$HEALTH_DISK"
        j_str storage_mount "$DISK_WORST_MOUNT"
        j_str wings "$HEALTH_WINGS"
        j_str docker "$HEALTH_DOCKER"
        j_str pterodactyl "$HEALTH_PTERO"
        j_str overall "$HEALTH_OVERALL"
        j_close
    fi
    j_close
    printf '%s\n' "$J_OUT"
}

# ============================================================================
# LIVE MODE
# ============================================================================
LIVE_ACTIVE=0
LIVE_BAR_W=24

live_cleanup() {
    (( LIVE_ACTIVE )) || return 0
    LIVE_ACTIVE=0
    printf '\e[0m\e[?25h\e[?1049l'
}

# live_bar LABEL PCT_X10 WARN CRIT DETAIL
live_bar() {
    local color bar
    level_color "$2" "$3" "$4"
    color=$REPLY
    make_bar "$2" "$LIVE_BAR_W" "$color"
    bar=$REPLY
    fmt_x10 "$2"
    printf ' %s%-5s%s %s %s%s%5s%%%s  %s%s%s\n' "$C_BOLD$C_WHITE" "$1" "$C_RST" "$bar" \
        "$C_BOLD" "$color" "$REPLY" "$C_RST" "$C_GRAY" "$5" "$C_RST"
}

# live_cols KEY PLAIN COLORED [...] - aligned key/value columns (colors excluded from width)
live_cols() {
    local out="" n
    while (( $# >= 3 )); do
        pad "$1" 9
        out+=" $C_GRAY$REPLY$C_RST"
        n=$(( 17 - ${#2} ))
        (( n < 1 )) && n=1
        printf -v REPLY '%*s' "$n" ''
        out+="$3$REPLY"
        shift 3
    done
    printf '%s\n' "$out"
}

render_live_frame() {
    local l1 u r c v1 v2 clock
    format_duration "$SYS_UPTIME_S" short
    l1="$SYS_HOSTNAME  ·  $SYS_OS_SHORT  ·  up $REPLY"
    print_box "ELITEHOST SERVERINFO  ·  LIVE" \
        "$C_BOLD${C_BRAND}ELITEHOST$C_RST $C_BOLD${C_WHITE}SERVERINFO$C_RST  $C_GRAY·$C_RST  $C_GREEN${C_BOLD}LIVE$C_RST" \
        "$l1" "$C_GRAY$l1$C_RST"
    echo
    live_bar "CPU" "${CPU_USAGE_X10:-0}" "$CFG_CPU_WARN" "$CFG_CPU_CRIT" "${CPU_THREADS:-?} threads"
    human_bytes "$MEM_USED"; u=$REPLY
    human_bytes "$MEM_TOTAL"
    live_bar "RAM" "$MEM_PCT_X10" "$CFG_RAM_WARN" "$CFG_RAM_CRIT" "$u / $REPLY"
    if (( SWAP_TOTAL > 0 )); then
        human_bytes "$SWAP_USED"; u=$REPLY
        human_bytes "$SWAP_TOTAL"
        live_bar "SWAP" "$SWAP_PCT_X10" "$CFG_RAM_WARN" "$CFG_RAM_CRIT" "$u / $REPLY"
    fi
    human_bytes "$ROOT_USED"; u=$REPLY
    human_bytes "$ROOT_SIZE"
    live_bar "DISK" "$ROOT_PCT_X10" "$CFG_DISK_WARN" "$CFG_DISK_CRIT" "$u / $REPLY"
    echo
    v1="$CPU_LOAD1 $CPU_LOAD5 $CPU_LOAD15"
    load_color "${CPU_LOAD1:-0}"
    c=$REPLY
    temp_value "$CPU_TEMP_C"
    v2=$REPLY
    u=${CPU_TEMP_C:+$CPU_TEMP_C°C}
    live_cols "Load" "$v1" "$c$v1$C_RST" "Temp" "${u:-N/A}" "$v2"
    format_mhz "$CPU_FREQ_MHZ"
    v1=$REPLY
    live_cols "Freq" "$v1" "$C_WHITE$v1$C_RST" "Tasks" "${CPU_TASKS:-N/A}" "$C_WHITE${CPU_TASKS:-N/A}$C_RST"
    if [[ -n $NET_IFACE ]]; then
        human_bytes "$LIVE_RX_RATE"; r="↓ $REPLY/s"
        human_bytes "$LIVE_TX_RATE"; r+="   ↑ $REPLY/s"
        printf ' %s%-9s%s%s%-8s%s %s\n' "$C_GRAY" "Network" "$C_RST" "$C_CYAN" "$NET_IFACE" "$C_RST" "$r"
    fi

    print_section "PTERODACTYL"
    if (( PTERO_DETECTED )); then
        state_color "$WINGS_STATE"; c=$REPLY
        state_color "$DOCKER_STATE"
        live_cols "Wings" "● $WINGS_STATE" "$c● $C_BOLD$WINGS_STATE$C_RST" \
                  "Docker" "● $DOCKER_STATE" "$REPLY● $C_BOLD$DOCKER_STATE$C_RST"
        v1=${PTERO_SERVERS:-N/A} v2=${PTERO_ONLINE:-N/A} u=${PTERO_OFFLINE:-N/A}
        c=$C_WHITE
        [[ $u =~ ^[1-9] ]] && c=$C_RED
        live_cols "Servers" "$v1" "$C_BOLD$C_WHITE$v1$C_RST" "Online" "$v2" "$C_GREEN$v2$C_RST"
        live_cols "Offline" "$u" "$c$u$C_RST" "Source" "${PTERO_SOURCE:-N/A}" "$C_GRAY${PTERO_SOURCE:-N/A}$C_RST"
    else
        print_kv "Status" "NOT DETECTED" "$C_GRAY"
    fi
    printf -v clock '%(%H:%M:%S)T' -1
    printf '\n %s%s  ·  refresh %ss  ·  press q or Ctrl+C to exit%s\n' "$C_GRAY" "$clock" "$CFG_LIVE_INTERVAL" "$C_RST"
}

LIVE_RX_RATE=0 LIVE_TX_RATE=0

live_mode() {
    local key rc frame rx0 tx0 us0 dt
    if [[ ! -t 1 ]]; then
        msg_err "--live requires an interactive terminal"
        return 1
    fi
    LIVE_ACTIVE=1
    trap 'live_cleanup; exit 0' INT TERM HUP
    trap 'live_cleanup' EXIT
    trap ':' WINCH
    printf '\e[?1049h\e[?25l\e[H\e[2J'
    printf '\n  %sEliteHost ServerInfo%s - collecting data...\n' "$C_BRAND" "$C_RST"

    query_services wings docker nginx apache2 pteroq
    get_system_info
    get_cpu_info
    get_network_info
    get_docker_info
    get_pterodactyl_info
    cpu_sample
    rx0=$NET_RX tx0=$NET_TX us0=$CPU_SAMPLE_US
    nap 0.5

    while :; do
        setup_layout
        LIVE_BAR_W=$(( W - 36 ))
        (( LIVE_BAR_W > 30 )) && LIVE_BAR_W=30
        (( LIVE_BAR_W < 10 )) && LIVE_BAR_W=10
        measure_cpu_usage 0
        get_cpu_dynamic
        get_clock
        get_memory_info
        get_disk_info
        if [[ -n $NET_IFACE ]]; then
            if ! read_first NET_RX "/sys/class/net/$NET_IFACE/statistics/rx_bytes" || ! is_uint "$NET_RX"; then NET_RX=$rx0; fi
            if ! read_first NET_TX "/sys/class/net/$NET_IFACE/statistics/tx_bytes" || ! is_uint "$NET_TX"; then NET_TX=$tx0; fi
            dt=$(( CPU_SAMPLE_US - us0 ))
            if (( dt > 0 )); then
                LIVE_RX_RATE=$(( (NET_RX - rx0) * 1000000 / dt ))
                LIVE_TX_RATE=$(( (NET_TX - tx0) * 1000000 / dt ))
                (( LIVE_RX_RATE < 0 )) && LIVE_RX_RATE=0
                (( LIVE_TX_RATE < 0 )) && LIVE_TX_RATE=0
            fi
            rx0=$NET_RX tx0=$NET_TX
        fi
        us0=$CPU_SAMPLE_US

        frame=$(render_live_frame)
        printf '\e[H%s\e[K\e[J' "${frame//$'\n'/$'\e[K\n'}"

        if { read -rsn1 -t "$CFG_LIVE_INTERVAL" key < /dev/tty; } 2>/dev/null; then
            [[ $key == [qQ] ]] && break
        else
            rc=$?
            (( rc <= 128 )) && nap "$CFG_LIVE_INTERVAL"
        fi
        # slower-changing data, refreshed inside the next measuring window
        query_services wings docker nginx apache2 pteroq
        get_docker_info
        get_pterodactyl_info refresh
    done
    live_cleanup
    return 0
}

