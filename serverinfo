#!/usr/bin/env bash
# ============================================================================
#  EliteHost ServerInfo
#  Server information & monitoring CLI for Pterodactyl hosting nodes.
#  Target platform: Debian 12 (bookworm) / Debian 13 (trixie), Bash 5.x
#
#  Signature: ELITEHOST-SERVERINFO   (used by install.sh / uninstall.sh)
#  License  : MIT
#
#  Security model
#   * Read-only. Never installs, starts, stops or reconfigures Pterodactyl,
#     Wings, Docker or any other service.
#   * Secrets (Wings token, panel database credentials, .env values) are
#     never printed. They stay in memory and reach child processes only
#     through pipes - never through argv or the environment.
#   * Never downloads or executes remote code. The only optional outbound
#     request is the public IP lookup, which is disabled by default.
#   * Every string taken from the system is stripped of control characters
#     before it is printed (terminal escape injection guard).
# ============================================================================

if [ -z "${BASH_VERSION:-}" ]; then
    echo "serverinfo: bash is required (try: bash $0)" >&2
    exit 1
fi
if [ "${BASH_VERSINFO[0]}" -lt 5 ]; then
    echo "serverinfo: bash >= 5.0 is required" >&2
    exit 1
fi

# No 'set -e': a monitoring tool must degrade gracefully, never abort
# because an optional command is missing or returns non-zero.
shopt -s nullglob
umask 077
export LC_ALL=C.UTF-8 2>/dev/null
for __d in /usr/local/sbin /usr/local/bin /usr/sbin /usr/bin /sbin /bin; do
    case ":${PATH:-}:" in *":$__d:"*) ;; *) PATH="${PATH:+$PATH:}$__d" ;; esac
done
unset __d
export PATH

readonly SI_VERSION="1.0.0"
readonly SI_NAME="EliteHost ServerInfo"
readonly SI_CONFIG_FILE="${SERVERINFO_CONFIG:-/etc/elitehost/serverinfo.conf}"
readonly SI_LIB_DIR="/usr/local/lib/elitehost-serverinfo"
readonly SI_START_US="${EPOCHREALTIME//[!0-9]/}"

# ----------------------------------------------------------------------------
# Configuration (defaults; overridable in /etc/elitehost/serverinfo.conf)
# ----------------------------------------------------------------------------
CFG_BRAND_COLOR=135                    # 256-color index of the EliteHost brand color
CFG_LOGO_COLORS="129 135 99 105 69 75" # logo gradient (one 256-color index per line)
CFG_PUBLIC_IP_LOOKUP=no                # yes = ask an external service for the public IP
CFG_PUBLIC_IP_URL="https://api.ipify.org"
CFG_WINGS_CONFIG=/etc/pterodactyl/config.yml
CFG_PANEL_DIR=""                       # empty = auto-detect
CFG_WINGS_API=auto                     # auto | off
CFG_PANEL_DATABASE=auto                # auto | off
CFG_CPU_WARN=70
CFG_CPU_CRIT=90
CFG_RAM_WARN=80
CFG_RAM_CRIT=90
CFG_DISK_WARN=80
CFG_DISK_CRIT=90
CFG_LIVE_INTERVAL=2

# ----------------------------------------------------------------------------
# Generic helpers (functions return data in REPLY to avoid subshell forks)
# ----------------------------------------------------------------------------
have() { command -v "$1" >/dev/null 2>&1; }

is_uint() { [[ $1 =~ ^[0-9]+$ ]]; }

HAVE_TIMEOUT=0
have timeout && HAVE_TIMEOUT=1

# run_timeout SECONDS CMD [ARGS...] - run a command with a hard time limit
run_timeout() {
    local secs=$1
    shift
    if (( HAVE_TIMEOUT )); then
        timeout -k 1 "$secs" "$@"
    else
        "$@"
    fi
}

# nap SECONDS - sleep (fractions allowed); builtin fallback when sleep is unavailable
nap() {
    sleep "$1" 2>/dev/null || read -rt "$1" <> <(:) 2>/dev/null
    return 0
}

# read_first VAR FILE - read the first line of FILE into VAR without forking
read_first() {
    local __rf_line=""
    { IFS= read -r __rf_line < "$2"; } 2>/dev/null || [[ -n $__rf_line ]] || return 1
    printf -v "$1" '%s' "$__rf_line"
}

# safe_read FILE [MAX_BYTES] -> REPLY : bounded, time-limited read of a regular,
# non-symlink file. Used for files owned by less privileged users (www-data panel
# files), which must never be able to hang or exhaust serverinfo running as root.
safe_read() {
    REPLY=""
    [[ -f $1 && ! -L $1 && -r $1 ]] || return 1
    REPLY=$(run_timeout 2 head -c "${2:-65536}" -- "$1" 2>/dev/null | tr -d '\0')
    [[ -n $REPLY ]]
}

# trim STRING -> REPLY
trim() {
    local s=$1
    s=${s#"${s%%[![:space:]]*}"}
    s=${s%"${s##*[![:space:]]}"}
    REPLY=$s
}

# utf8_safe STRING -> REPLY : valid UTF-8 passes unchanged; otherwise every
# non-ASCII byte becomes '?' (keeps JSON valid, defeats raw 8-bit CSI bytes)
utf8_safe() {
    REPLY=$1
    [[ $REPLY == *[![:ascii:]]* ]] || return 0
    if ! iconv -f UTF-8 -t UTF-8 <<< "$REPLY" >/dev/null 2>&1; then
        local LC_ALL=C
        REPLY=${REPLY//[^ -~]/?}
    fi
}

# clean STRING -> REPLY : strip control characters (escape injection guard) and trim
clean() {
    utf8_safe "$1"
    trim "${REPLY//[[:cntrl:]]/}"
}

# repeat_str STRING COUNT -> REPLY
repeat_str() {
    local out
    printf -v out '%*s' "$2" ''
    REPLY=${out// /$1}
}

# human_bytes BYTES -> REPLY (IEC units with one decimal, e.g. "1.8 TiB")
human_bytes() {
    local b=$1 i=0 div=1 scaled
    local -a units=(B KiB MiB GiB TiB PiB EiB)
    if ! is_uint "$b"; then
        REPLY="N/A"
        return 1
    fi
    while (( i < 6 && b >= div * 1024 )); do
        div=$(( div * 1024 ))
        i=$(( i + 1 ))
    done
    if (( i == 0 )); then
        REPLY="$b B"
        return 0
    fi
    scaled=$(( (b * 10 + div / 2) / div ))
    if (( scaled >= 10240 && i < 6 )); then
        div=$(( div * 1024 ))
        i=$(( i + 1 ))
        scaled=$(( (b * 10 + div / 2) / div ))
    fi
    REPLY="$(( scaled / 10 )).$(( scaled % 10 )) ${units[i]}"
}

# pct_x10 PART TOTAL -> REPLY (percentage * 10, rounded; 1 on unknown input)
pct_x10() {
    if is_uint "$1" && is_uint "$2" && (( $2 > 0 )); then
        REPLY=$(( ($1 * 1000 + $2 / 2) / $2 ))
        return 0
    fi
    REPLY=0
    return 1
}

# fmt_x10 VALUE_X10 -> REPLY ("23.4")
fmt_x10() {
    REPLY="$(( $1 / 10 )).$(( $1 % 10 ))"
}

# plural N WORD -> REPLY ("1 day", "3 days")
plural() {
    if (( $1 == 1 )); then REPLY="$1 $2"; else REPLY="$1 ${2}s"; fi
}

# format_duration SECONDS [short] -> REPLY ("12 days, 4 hours, 3 minutes" | "12d 4h 3m")
format_duration() {
    local s=${1:-0} d h m
    local -a parts=()
    d=$(( s / 86400 ))
    h=$(( s % 86400 / 3600 ))
    m=$(( s % 3600 / 60 ))
    if [[ ${2:-} == short ]]; then
        (( d > 0 )) && parts+=("${d}d")
        (( h > 0 )) && parts+=("${h}h")
        (( d == 0 )) && parts+=("${m}m")
        REPLY="${parts[*]}"
        return 0
    fi
    if (( d > 0 )); then plural "$d" day; parts+=("$REPLY"); fi
    if (( h > 0 )); then plural "$h" hour; parts+=("$REPLY"); fi
    if (( d == 0 && (m > 0 || h == 0) )); then plural "$m" minute; parts+=("$REPLY"); fi
    local IFS=','
    REPLY="${parts[*]}"
    REPLY=${REPLY//,/, }
}

# format_mhz MHZ -> REPLY ("3.10 GHz" | "800 MHz")
format_mhz() {
    local mhz=$1
    if ! is_uint "$mhz" || (( mhz == 0 )); then
        REPLY="N/A"
        return 1
    fi
    if (( mhz >= 1000 )); then
        local c=$(( (mhz + 5) / 10 ))
        printf -v REPLY '%d.%02d GHz' $(( c / 100 )) $(( c % 100 ))
    else
        REPLY="$mhz MHz"
    fi
}

# json_escape STRING -> REPLY (quoted JSON string, or null when empty)
json_escape() {
    local s=$1
    if [[ -z $s ]]; then
        REPLY=null
        return 0
    fi
    s=${s//\\/\\\\}
    s=${s//\"/\\\"}
    s=${s//$'\n'/\\n}
    s=${s//$'\t'/\\t}
    s=${s//$'\r'/\\r}
    utf8_safe "$s"
    s=${REPLY//[[:cntrl:]]/}
    REPLY="\"$s\""
}

# ----------------------------------------------------------------------------
# Configuration loader - KEY=VALUE parser (the file is never sourced)
# ----------------------------------------------------------------------------
normalize_bool() {
    case ${1,,} in
        yes|true|on|1) REPLY=yes ;;
        no|false|off|0) REPLY=no ;;
        *) return 1 ;;
    esac
}

load_config() {
    local file=$SI_CONFIG_FILE line key val
    [[ -r $file && -f $file ]] || return 0
    while IFS= read -r line || [[ -n $line ]]; do
        line=${line%$'\r'}
        [[ $line =~ ^[[:space:]]*([A-Z][A-Z0-9_]*)[[:space:]]*=[[:space:]]*(.*)$ ]] || continue
        key=${BASH_REMATCH[1]}
        val=${BASH_REMATCH[2]}
        if [[ $val =~ ^\"([^\"]*)\" ]] || [[ $val =~ ^\'([^\']*)\' ]]; then
            val=${BASH_REMATCH[1]}
        else
            val=${val%%#*}
            trim "$val"
            val=$REPLY
        fi
        case $key in
            BRAND_COLOR)
                is_uint "$val" && (( 10#$val <= 255 )) && CFG_BRAND_COLOR=$(( 10#$val )) ;;
            LOGO_COLORS)
                [[ $val =~ ^[0-9\ ]+$ ]] && CFG_LOGO_COLORS=$val ;;
            PUBLIC_IP_LOOKUP)
                normalize_bool "$val" && CFG_PUBLIC_IP_LOOKUP=$REPLY ;;
            PUBLIC_IP_URL)
                [[ $val =~ ^https://[A-Za-z0-9./?=_%:~-]+$ ]] && CFG_PUBLIC_IP_URL=$val ;;
            WINGS_CONFIG)
                [[ $val == /* ]] && CFG_WINGS_CONFIG=$val ;;
            PANEL_DIR)
                [[ -z $val || $val == /* ]] && CFG_PANEL_DIR=${val%/} ;;
            WINGS_API)
                [[ $val == auto || $val == off ]] && CFG_WINGS_API=$val ;;
            PANEL_DATABASE)
                [[ $val == auto || $val == off ]] && CFG_PANEL_DATABASE=$val ;;
            CPU_WARN|CPU_CRIT|RAM_WARN|RAM_CRIT|DISK_WARN|DISK_CRIT)
                is_uint "$val" && (( 10#$val <= 100 )) && printf -v "CFG_$key" '%d' $(( 10#$val )) ;;
            LIVE_INTERVAL)
                is_uint "$val" && (( 10#$val >= 1 && 10#$val <= 60 )) && CFG_LIVE_INTERVAL=$(( 10#$val )) ;;
        esac
    done < "$file"
}

# ----------------------------------------------------------------------------
# Terminal: colors & layout
# ----------------------------------------------------------------------------
COLOR_MODE=auto   # auto | always | never
USE_COLOR=0
C_RST="" C_BOLD="" C_BRAND="" C_WHITE="" C_CYAN="" C_GREEN="" C_YELLOW="" C_RED="" C_GRAY=""
LOGO_COLORS=()

setup_colors() {
    case $COLOR_MODE in
        never) USE_COLOR=0 ;;
        always) USE_COLOR=1 ;;
        *)
            USE_COLOR=0
            [[ -t 1 && -z ${NO_COLOR:-} && ${TERM:-dumb} != dumb ]] && USE_COLOR=1
            ;;
    esac
    C_RST="" C_BOLD="" C_BRAND="" C_WHITE="" C_CYAN="" C_GREEN="" C_YELLOW="" C_RED="" C_GRAY=""
    LOGO_COLORS=()
    (( USE_COLOR )) || return 0

    local ncolors=0 c
    if have tput; then
        ncolors=$(tput colors 2>/dev/null) || ncolors=0
    fi
    is_uint "$ncolors" || ncolors=0
    case ${COLORTERM:-} in truecolor|24bit) ncolors=256 ;; esac
    [[ ${TERM:-} == *256color* ]] && (( ncolors < 256 )) && ncolors=256

    C_RST=$'\e[0m'
    C_BOLD=$'\e[1m'
    if (( ncolors >= 16 )); then
        C_WHITE=$'\e[97m' C_CYAN=$'\e[96m' C_GREEN=$'\e[92m'
        C_YELLOW=$'\e[93m' C_RED=$'\e[91m' C_GRAY=$'\e[90m'
    else
        C_WHITE=$'\e[1;37m' C_CYAN=$'\e[36m' C_GREEN=$'\e[32m'
        C_YELLOW=$'\e[33m' C_RED=$'\e[31m' C_GRAY=$'\e[37m'
    fi
    if (( ncolors >= 256 )); then
        C_BRAND=$'\e[38;5;'"${CFG_BRAND_COLOR}m"
        for c in $CFG_LOGO_COLORS; do
            (( 10#$c <= 255 )) && LOGO_COLORS+=($'\e[38;5;'"$(( 10#$c ))m")
        done
    else
        C_BRAND=$'\e[35m'
    fi
}

W=58          # layout width (columns)
KEY_W=14      # key column width
BAR_W=24      # progress bar width
RULE=""

setup_layout() {
    local cols=0
    if [[ -t 1 ]]; then
        if have tput; then cols=$(tput cols 2>/dev/null) || cols=0; fi
        if ! is_uint "$cols" || (( cols == 0 )); then
            read -r _ cols < <(stty size 2>/dev/null < /dev/tty) || cols=0
        fi
    fi
    is_uint "$cols" && (( cols > 0 )) || cols=80
    W=58
    (( cols - 2 < W )) && W=$(( cols - 2 ))
    (( W < 40 )) && W=40
    BAR_W=$(( W - KEY_W - 12 ))
    (( BAR_W > 24 )) && BAR_W=24
    (( BAR_W < 8 )) && BAR_W=8
    repeat_str "─" "$W"
    RULE=$REPLY
}

# ----------------------------------------------------------------------------
# Output primitives
# ----------------------------------------------------------------------------
print_section() {
    printf '\n %s%s%s%s\n' "$C_BOLD" "$C_BRAND" "$1" "$C_RST"
    printf ' %s%s%s\n' "$C_GRAY" "$RULE" "$C_RST"
}

# print_kv KEY VALUE [COLOR]   (pass "" as COLOR for pre-colored values)
print_kv() {
    local color=${3-$C_WHITE}
    [[ $2 == N/A* ]] && color=$C_GRAY
    printf ' %s%-*s%s %s%s%s\n' "$C_GRAY" "$KEY_W" "$1" "$C_RST" "$color" "$2" "$C_RST"
}

# print_status LABEL STATE
print_status() {
    state_color "$2"
    printf ' %s●%s %-13s%s%s%s%s\n' "$REPLY" "$C_RST" "$1" "$C_BOLD" "$REPLY" "$2" "$C_RST"
}

# state_color STATE -> REPLY (color escape for a status word)
state_color() {
    case $1 in
        HEALTHY|ONLINE|RUNNING|DETECTED|UP|ACTIVE) REPLY=$C_GREEN ;;
        WARNING|STARTING|UNKNOWN|"NO ACCESS"|DEGRADED) REPLY=$C_YELLOW ;;
        HIGH|CRITICAL|OFFLINE|STOPPED|DOWN|FAILED) REPLY=$C_RED ;;
        *) REPLY=$C_GRAY ;;
    esac
}

# level_color PCT_X10 WARN CRIT -> REPLY
level_color() {
    if (( $1 >= $3 * 10 )); then
        REPLY=$C_RED
    elif (( $1 >= $2 * 10 )); then
        REPLY=$C_YELLOW
    else
        REPLY=$C_GREEN
    fi
}

# make_bar PCT_X10 WIDTH COLOR -> REPLY
make_bar() {
    local p=$1 w=$2 color=$3 fill filled
    (( p < 0 )) && p=0
    (( p > 1000 )) && p=1000
    fill=$(( (p * w + 500) / 1000 ))
    repeat_str "█" "$fill"
    filled=$REPLY
    repeat_str "░" $(( w - fill ))
    REPLY="${color}${filled}${C_GRAY}${REPLY}${C_RST}"
}

# usage_value PCT_X10 WARN CRIT -> REPLY ("<bar> 23.4%", colored)
usage_value() {
    local color
    level_color "$1" "$2" "$3"
    color=$REPLY
    make_bar "$1" "$BAR_W" "$color"
    local bar=$REPLY
    fmt_x10 "$1"
    printf -v REPLY '%s %s%5s%%%s' "$bar" "$color$C_BOLD" "$REPLY" "$C_RST"
}

# print_box PLAIN COLORED [PLAIN COLORED ...] - centered lines inside a rounded box
print_box() {
    local inner=$(( W - 1 )) plain colored pl pr hr
    repeat_str "─" "$inner"
    hr=$REPLY
    printf '%s╭%s╮%s\n' "$C_BRAND" "$hr" "$C_RST"
    while (( $# >= 2 )); do
        plain=$1 colored=$2
        shift 2
        if (( ${#plain} > inner )); then
            plain=${plain:0:inner}
            colored=$plain
        fi
        pl=$(( (inner - ${#plain}) / 2 ))
        pr=$(( inner - ${#plain} - pl ))
        printf '%s│%s%*s%s%*s%s│%s\n' "$C_BRAND" "$C_RST" "$pl" '' "$colored" "$pr" '' "$C_BRAND" "$C_RST"
    done
    printf '%s╰%s╯%s\n' "$C_BRAND" "$hr" "$C_RST"
}

print_logo() {
    local -a logo=(
        '███████╗██╗     ██╗████████╗███████╗'
        '██╔════╝██║     ██║╚══██╔══╝██╔════╝'
        '█████╗  ██║     ██║   ██║   █████╗  '
        '██╔══╝  ██║     ██║   ██║   ██╔══╝  '
        '███████╗███████╗██║   ██║   ███████╗'
        '╚══════╝╚══════╝╚═╝   ╚═╝   ╚══════╝'
    )
    local i pad color
    pad=$(( (W + 1 - 36) / 2 ))
    echo
    for i in "${!logo[@]}"; do
        color=${LOGO_COLORS[i]:-$C_BRAND}
        printf '%*s%s%s%s\n' "$pad" '' "$color" "${logo[i]}" "$C_RST"
    done
    pad=$(( (W + 1 - 20) / 2 ))
    printf '%*s%s%sELITEHOST%s %s%sSERVERINFO%s\n\n' "$pad" '' \
        "$C_BOLD" "$C_BRAND" "$C_RST" "$C_BOLD" "$C_WHITE" "$C_RST"
}

msg_err() { printf '%sserverinfo:%s %s\n' "$C_RED" "$C_RST" "$*" >&2; }

# ============================================================================
# SYSTEM
# ============================================================================
SYS_OS="Linux" SYS_OS_ID="" SYS_OS_VERSION_ID="" SYS_CODENAME="" SYS_DEBIAN_VERSION=""
SYS_OS_SHORT="" SYS_KERNEL="" SYS_ARCH="" SYS_HOSTNAME="" SYS_UPTIME_S=0
SYS_BOOT_TIME="" SYS_DATETIME="" SYS_TIMEZONE="" SYS_UTC_OFFSET=""
SYS_VIRT="" SYS_VIRT_LABEL="" SYS_VENDOR="" SYS_MODEL=""
NOW_EPOCH=0

is_placeholder_dmi() {
    case ${1,,} in
        ""|"to be filled by o.e.m."|"default string"|"system product name"|"system manufacturer"|\
        "not specified"|"not applicable"|"not available"|none|"o.e.m."|oem|"system version"|\
        unknown|type1productconfigid|0123456789|123456789|x.x|"base board product name"|\
        "base board manufacturer"|"system serial number")
            return 0 ;;
    esac
    return 1
}

get_system_info() {
    local key val ver
    if [[ -r /etc/os-release ]]; then
        while IFS='=' read -r key val; do
            val=${val#[\"\']}
            val=${val%[\"\']}
            case $key in
                PRETTY_NAME) clean "$val"; SYS_OS=$REPLY ;;
                ID) clean "$val"; SYS_OS_ID=$REPLY ;;
                VERSION_ID) clean "$val"; SYS_OS_VERSION_ID=$REPLY ;;
                VERSION_CODENAME) clean "$val"; SYS_CODENAME=$REPLY ;;
            esac
        done < /etc/os-release
    fi
    if read_first SYS_DEBIAN_VERSION /etc/debian_version; then
        clean "$SYS_DEBIAN_VERSION"
        SYS_DEBIAN_VERSION=$REPLY
    fi
    if [[ $SYS_OS_ID != debian ]]; then
        SYS_DEBIAN_VERSION=""   # derivatives (e.g. Ubuntu) ship /etc/debian_version too
    fi
    if [[ $SYS_OS_ID == debian ]]; then
        ver=$SYS_OS_VERSION_ID
        [[ $SYS_DEBIAN_VERSION =~ ^[0-9]+(\.[0-9]+)?$ ]] && ver=$SYS_DEBIAN_VERSION
        SYS_OS_SHORT="Debian ${ver:-testing}${SYS_CODENAME:+ ($SYS_CODENAME)}"
    else
        SYS_OS_SHORT=$SYS_OS
    fi

    read_first SYS_KERNEL /proc/sys/kernel/osrelease || SYS_KERNEL=$(uname -r 2>/dev/null)
    SYS_ARCH=$(uname -m 2>/dev/null) || SYS_ARCH=${HOSTTYPE:-unknown}
    read_first SYS_HOSTNAME /proc/sys/kernel/hostname || SYS_HOSTNAME=$(uname -n 2>/dev/null)
    clean "$SYS_HOSTNAME"
    SYS_HOSTNAME=${REPLY:-localhost}

    get_clock
    printf -v SYS_BOOT_TIME '%(%Y-%m-%d %H:%M:%S)T' $(( NOW_EPOCH - SYS_UPTIME_S ))
    get_timezone
    detect_virtualization
    get_hardware_model
}

# get_clock - uptime and current date/time (cheap; refreshed every live frame)
get_clock() {
    local up=""
    read_first up /proc/uptime
    SYS_UPTIME_S=${up%%.*}
    is_uint "$SYS_UPTIME_S" || SYS_UPTIME_S=0
    printf -v NOW_EPOCH '%(%s)T' -1
    printf -v SYS_DATETIME '%(%Y-%m-%d %H:%M:%S)T' "$NOW_EPOCH"
}

get_timezone() {
    local tz="" link off
    if [[ -L /etc/localtime ]]; then
        link=$(readlink /etc/localtime 2>/dev/null)
        [[ $link == *zoneinfo/* ]] && tz=${link##*zoneinfo/}
    fi
    [[ -z $tz ]] && read_first tz /etc/timezone
    [[ -z $tz && -n ${TZ:-} ]] && tz=$TZ
    clean "$tz"
    SYS_TIMEZONE=${REPLY:-UTC}
    printf -v off '%(%z)T' -1
    SYS_UTC_OFFSET="UTC${off:0:3}:${off:3:2}"
}

detect_virtualization() {
    local v=""
    if have systemd-detect-virt; then
        v=$(run_timeout 2 systemd-detect-virt 2>/dev/null)
    fi
    if [[ -z $v ]]; then
        if [[ -f /.dockerenv ]]; then
            v=docker
        elif [[ -f /run/.containerenv ]]; then
            v=podman
        elif grep -qw -m1 hypervisor /proc/cpuinfo 2>/dev/null; then
            v=vm
        elif [[ $SYS_ARCH == x86_64 || $SYS_ARCH == i?86 ]]; then
            v=none
        fi
    fi
    SYS_VIRT=${v:-unknown}
    case $SYS_VIRT in
        none)            SYS_VIRT_LABEL="None (bare-metal)" ;;
        kvm)             SYS_VIRT_LABEL="KVM" ;;
        qemu)            SYS_VIRT_LABEL="QEMU" ;;
        vmware)          SYS_VIRT_LABEL="VMware" ;;
        microsoft)       SYS_VIRT_LABEL="Microsoft Hyper-V" ;;
        xen)             SYS_VIRT_LABEL="Xen" ;;
        oracle)          SYS_VIRT_LABEL="Oracle VirtualBox" ;;
        amazon)          SYS_VIRT_LABEL="Amazon EC2 (Nitro)" ;;
        google)          SYS_VIRT_LABEL="Google Compute Engine" ;;
        parallels)       SYS_VIRT_LABEL="Parallels" ;;
        bhyve)           SYS_VIRT_LABEL="bhyve" ;;
        openvz)          SYS_VIRT_LABEL="OpenVZ (container)" ;;
        lxc|lxc-libvirt) SYS_VIRT_LABEL="LXC (container)" ;;
        systemd-nspawn)  SYS_VIRT_LABEL="systemd-nspawn (container)" ;;
        docker)          SYS_VIRT_LABEL="Docker (container)" ;;
        podman)          SYS_VIRT_LABEL="Podman (container)" ;;
        wsl)             SYS_VIRT_LABEL="WSL" ;;
        vm)              SYS_VIRT_LABEL="Virtual machine" ;;
        unknown)         SYS_VIRT_LABEL="N/A" ;;
        *)               clean "$SYS_VIRT"; SYS_VIRT_LABEL=$REPLY ;;
    esac
}

is_virtual_machine() {
    case $SYS_VIRT in none|unknown|docker|podman|lxc|lxc-libvirt|openvz|systemd-nspawn) return 1 ;; esac
    return 0
}

get_hardware_model() {
    local d=/sys/class/dmi/id vendor="" product="" bvendor="" bname="" dt="" var
    read_first vendor "$d/sys_vendor"
    read_first product "$d/product_name"
    read_first bvendor "$d/board_vendor"
    read_first bname "$d/board_name"
    for var in vendor product bvendor bname; do
        clean "${!var}"
        is_placeholder_dmi "$REPLY" && REPLY=""
        printf -v "$var" '%s' "$REPLY"
    done
    SYS_VENDOR=${vendor:-$bvendor}
    if [[ -n $product && -n $bname && $bname != "$product" ]]; then
        SYS_MODEL="$product (board $bname)"
    else
        SYS_MODEL=${product:-$bname}
    fi
    if [[ -z $SYS_MODEL && -r /sys/firmware/devicetree/base/model ]]; then
        { IFS= read -r -d '' dt < /sys/firmware/devicetree/base/model; } 2>/dev/null
        clean "$dt"
        SYS_MODEL=$REPLY
    fi
}

# ============================================================================
# CPU
# ============================================================================
CPU_MODEL="" CPU_VENDOR="" CPU_CORES="" CPU_THREADS="" CPU_SOCKETS=""
CPU_FREQ_MHZ="" CPU_MAX_MHZ="" CPU_TEMP_C="" CPU_USAGE_X10=""
CPU_LOAD1="" CPU_LOAD5="" CPU_LOAD15="" CPU_TASKS="" CPU_RUNNING=""
CPU_SAMPLE_TOTAL=0 CPU_SAMPLE_IDLE=0 CPU_SAMPLE_US=0 CPU_LSCPU_MHZ=""

# cpu_sample - snapshot of the aggregate "cpu" line of /proc/stat
cpu_sample() {
    local label user=0 nice=0 system=0 idle=0 iowait=0 irq=0 softirq=0 steal=0 rest
    { read -r label user nice system idle iowait irq softirq steal rest < /proc/stat; } 2>/dev/null
    CPU_SAMPLE_TOTAL=$(( ${user:-0} + ${nice:-0} + ${system:-0} + ${idle:-0} + ${iowait:-0} + ${irq:-0} + ${softirq:-0} + ${steal:-0} ))
    CPU_SAMPLE_IDLE=$(( ${idle:-0} + ${iowait:-0} ))
    CPU_SAMPLE_US=${EPOCHREALTIME//[!0-9]/}
}

# measure_cpu_usage [MIN_WINDOW_US] - real-time usage since the previous
# cpu_sample; waits only for whatever part of the window has not elapsed yet.
measure_cpu_usage() {
    local t0=$CPU_SAMPLE_TOTAL i0=$CPU_SAMPLE_IDLE us0=$CPU_SAMPLE_US min_us=${1:-500000}
    local now wait dt di
    now=${EPOCHREALTIME//[!0-9]/}
    wait=$(( min_us - (now - us0) ))
    if (( wait > 0 )); then
        printf -v wait '%d.%06d' $(( wait / 1000000 )) $(( wait % 1000000 ))
        nap "$wait"
    fi
    cpu_sample
    dt=$(( CPU_SAMPLE_TOTAL - t0 ))
    di=$(( CPU_SAMPLE_IDLE - i0 ))
    CPU_USAGE_X10=0
    if (( dt > 0 )); then
        CPU_USAGE_X10=$(( (1000 * (dt - di) + dt / 2) / dt ))
        (( CPU_USAGE_X10 < 0 )) && CPU_USAGE_X10=0
        (( CPU_USAGE_X10 > 1000 )) && CPU_USAGE_X10=1000
    fi
}

get_cpu_info() {
    local out="" line key val tpc="" cps="" sockets="" max_mhz="" cur_mhz="" v f
    if have lscpu; then
        out=$(run_timeout 3 lscpu 2>/dev/null)
    fi
    while IFS= read -r line; do
        [[ $line == *:* ]] || continue
        trim "${line%%:*}"; key=$REPLY
        trim "${line#*:}"; val=$REPLY
        case $key in
            "Model name")          [[ -z $CPU_MODEL ]] && CPU_MODEL=$val ;;
            "Vendor ID")           [[ -z $CPU_VENDOR ]] && CPU_VENDOR=$val ;;
            "CPU(s)")              [[ -z $CPU_THREADS ]] && CPU_THREADS=$val ;;
            "Thread(s) per core")  [[ -z $tpc ]] && tpc=$val ;;
            "Core(s) per socket"|"Core(s) per cluster") [[ -z $cps ]] && cps=$val ;;
            "Socket(s)")           [[ -z $sockets ]] && sockets=$val ;;
            "CPU max MHz")         [[ -z $max_mhz ]] && max_mhz=${val%%.*} ;;
            "CPU MHz")             [[ -z $cur_mhz ]] && cur_mhz=${val%%.*} ;;
        esac
    done <<< "$out"

    if [[ -z $CPU_MODEL && -r /proc/cpuinfo ]]; then
        while IFS= read -r line; do
            case $line in
                "model name"*|"cpu model"*|"Model"*|"Hardware"*) CPU_MODEL=${line#*:}; break ;;
            esac
        done < /proc/cpuinfo
    fi
    # "Intel(R) Xeon(R) CPU E5-2680 v4 @ 2.40GHz" -> "Intel Xeon E5-2680 v4 @ 2.40GHz"
    clean "$CPU_MODEL"
    v=$REPLY
    v=${v//(R)/}; v=${v//(r)/}; v=${v//(TM)/}; v=${v//(tm)/}
    v=${v// CPU / }
    [[ $v =~ ^(.*[^ ])\ +[0-9]+-Core\ Processor$ ]] && v=${BASH_REMATCH[1]}
    v=${v% Processor}
    while [[ $v == *"  "* ]]; do v=${v//  / }; done
    CPU_MODEL=${v:-Unknown}
    clean "$CPU_VENDOR"; CPU_VENDOR=$REPLY

    if ! is_uint "$CPU_THREADS"; then
        CPU_THREADS=$(getconf _NPROCESSORS_ONLN 2>/dev/null) || CPU_THREADS=""
    fi
    if ! is_uint "$CPU_THREADS" && read_first v /sys/devices/system/cpu/online; then
        count_cpu_list "$v" && CPU_THREADS=$REPLY
    fi

    # Physical cores / sockets from sysfs topology (architecture independent)
    local -A seen_core=() seen_pkg=()
    local topo core pkg cluster
    for topo in /sys/devices/system/cpu/cpu[0-9]*/topology; do
        read_first core "$topo/core_id" || continue
        read_first pkg "$topo/physical_package_id" || pkg=0
        cluster=""
        read_first cluster "$topo/cluster_id"
        seen_core["$pkg:$cluster:$core"]=1
        seen_pkg["$pkg"]=1
    done
    if (( ${#seen_core[@]} > 0 )); then
        CPU_CORES=${#seen_core[@]}
    elif is_uint "$cps" && is_uint "$sockets"; then
        CPU_CORES=$(( cps * sockets ))
    fi
    if is_uint "$sockets"; then
        CPU_SOCKETS=$sockets
    elif (( ${#seen_pkg[@]} > 0 )); then
        CPU_SOCKETS=${#seen_pkg[@]}
    fi
    if is_uint "$CPU_CORES" && is_uint "$CPU_THREADS" && (( CPU_CORES > CPU_THREADS )); then
        CPU_CORES=$CPU_THREADS
    fi

    if read_first v /sys/devices/system/cpu/cpu0/cpufreq/cpuinfo_max_freq && is_uint "$v"; then
        CPU_MAX_MHZ=$(( v / 1000 ))
    elif is_uint "$max_mhz"; then
        CPU_MAX_MHZ=$max_mhz
    fi
    CPU_LSCPU_MHZ=$cur_mhz
    get_cpu_dynamic
}

# count_cpu_list LIST -> REPLY ("0-3,5,7-8" -> 7)
count_cpu_list() {
    local part n=0 a b
    local -a parts=()
    IFS=, read -r -a parts <<< "$1"
    for part in "${parts[@]}"; do
        if [[ $part =~ ^([0-9]+)-([0-9]+)$ ]]; then
            a=$(( 10#${BASH_REMATCH[1]} )) b=$(( 10#${BASH_REMATCH[2]} ))
            (( b >= a )) && n=$(( n + b - a + 1 ))
        elif is_uint "$part"; then
            n=$(( n + 1 ))
        fi
    done
    (( n > 0 )) || return 1
    REPLY=$n
}

# get_cpu_dynamic - frequency, load average, processes, temperature (cheap; live mode)
get_cpu_dynamic() {
    local f v sum=0 n=0 l1 l5 l15 procs
    for f in /sys/devices/system/cpu/cpu[0-9]*/cpufreq/scaling_cur_freq; do
        if read_first v "$f" && is_uint "$v"; then
            sum=$(( sum + v ))
            n=$(( n + 1 ))
        fi
    done
    if (( n > 0 )); then
        CPU_FREQ_MHZ=$(( sum / n / 1000 ))
    elif is_uint "$CPU_LSCPU_MHZ" && (( CPU_LSCPU_MHZ > 0 )); then
        CPU_FREQ_MHZ=$CPU_LSCPU_MHZ
    elif [[ -r /proc/cpuinfo ]]; then
        CPU_FREQ_MHZ=$(awk -F: '/^cpu MHz/ { s += $2; n++ } END { if (n) printf "%d", s / n }' /proc/cpuinfo 2>/dev/null)
    fi
    if { read -r l1 l5 l15 procs _ < /proc/loadavg; } 2>/dev/null; then
        CPU_LOAD1=$l1 CPU_LOAD5=$l5 CPU_LOAD15=$l15
        CPU_RUNNING=${procs%/*} CPU_TASKS=${procs#*/}
    fi
    get_cpu_temp
}

# get_cpu_temp - CPU package temperature from hwmon/thermal sysfs (no lm-sensors needed)
get_cpu_temp() {
    local hw name input label t best="" pref="" zone type
    CPU_TEMP_C=""
    for hw in /sys/class/hwmon/hwmon*; do
        read_first name "$hw/name" || continue
        case $name in
            coretemp|k10temp|zenpower|cpu_thermal|cpu-thermal|soc_thermal|x86_pkg_temp|cputemp) ;;
            *) continue ;;
        esac
        for input in "$hw"/temp*_input; do
            if ! read_first t "$input" || ! is_uint "$t"; then continue; fi
            t=$(( (t + 500) / 1000 ))
            (( t > 0 && t < 150 )) || continue
            label=""
            read_first label "${input%_input}_label"
            case $label in
                "Package id"*|Tctl|Tdie) (( t > ${pref:-0} )) && pref=$t ;;
            esac
            (( t > ${best:-0} )) && best=$t
        done
    done
    if [[ -z $pref && -z $best ]]; then
        for zone in /sys/class/thermal/thermal_zone*; do
            read_first type "$zone/type" || continue
            case $type in
                x86_pkg_temp|cpu-thermal|cpu_thermal|soc-thermal|soc_thermal|cpu*) ;;
                *) continue ;;
            esac
            if ! read_first t "$zone/temp" || ! is_uint "$t"; then continue; fi
            t=$(( (t + 500) / 1000 ))
            (( t > 0 && t < 150 && t > ${best:-0} )) && best=$t
        done
    fi
    CPU_TEMP_C=${pref:-$best}
}

# ============================================================================
# MEMORY
# ============================================================================
MEM_TOTAL=0 MEM_FREE=0 MEM_AVAILABLE=0 MEM_USED=0 MEM_CACHED=0 MEM_PCT_X10=0
SWAP_TOTAL=0 SWAP_FREE=0 SWAP_USED=0 SWAP_PCT_X10=0

get_memory_info() {
    local key val unit buffers=0 cached=0 sreclaim=0 avail=""
    MEM_TOTAL=0 MEM_FREE=0 SWAP_TOTAL=0 SWAP_FREE=0
    [[ -r /proc/meminfo ]] || return 1
    while read -r key val unit; do
        is_uint "$val" || continue
        case $key in
            MemTotal:)     MEM_TOTAL=$(( val * 1024 )) ;;
            MemFree:)      MEM_FREE=$(( val * 1024 )) ;;
            MemAvailable:) avail=$(( val * 1024 )) ;;
            Buffers:)      buffers=$(( val * 1024 )) ;;
            Cached:)       cached=$(( val * 1024 )) ;;
            SReclaimable:) sreclaim=$(( val * 1024 )) ;;
            SwapTotal:)    SWAP_TOTAL=$(( val * 1024 )) ;;
            SwapFree:)     SWAP_FREE=$(( val * 1024 )) ;;
        esac
    done < /proc/meminfo
    MEM_CACHED=$(( buffers + cached + sreclaim ))
    MEM_AVAILABLE=${avail:-$(( MEM_FREE + MEM_CACHED ))}
    (( MEM_AVAILABLE > MEM_TOTAL )) && MEM_AVAILABLE=$MEM_TOTAL
    MEM_USED=$(( MEM_TOTAL - MEM_AVAILABLE ))
    pct_x10 "$MEM_USED" "$MEM_TOTAL"
    MEM_PCT_X10=$REPLY
    SWAP_USED=$(( SWAP_TOTAL - SWAP_FREE ))
    (( SWAP_USED < 0 )) && SWAP_USED=0
    pct_x10 "$SWAP_USED" "$SWAP_TOTAL"
    SWAP_PCT_X10=$REPLY
}

# ============================================================================
# STORAGE
# ============================================================================
readonly FS_SEP=$'\x1f'
ROOT_SRC="" ROOT_FSTYPE="" ROOT_SIZE=0 ROOT_USED=0 ROOT_AVAIL=0 ROOT_PCT_X10=0 ROOT_MAJMIN=""
ROOT_KIND="" ROOT_MODEL="" ROOT_LAYOUT=""
FS_LIST=()             # non-root filesystems: mount<US>type<US>size<US>used<US>avail<US>pct_x10<US>source
DISK_WORST_PCT_X10=0 DISK_WORST_MOUNT="/"
RESOLVED_DISKS=() RESOLVED_RAID="" RESOLVED_LVM=0 RESOLVED_CRYPT=0

get_disk_info() {
    local out src type size used avail mnt entry
    local -a f
    local -A seen=() ro=()
    FS_LIST=()
    ROOT_SRC="" ROOT_FSTYPE="" ROOT_SIZE=0 ROOT_USED=0 ROOT_AVAIL=0 ROOT_PCT_X10=0 ROOT_MAJMIN=""
    if [[ -r /proc/self/mountinfo ]]; then
        while read -r -a f; do
            [[ ${f[4]} == / ]] && ROOT_MAJMIN=${f[2]}
            if [[ ${f[5]} == ro || ${f[5]} == ro,* ]]; then ro[${f[4]}]=1; else ro[${f[4]}]=0; fi
        done < /proc/self/mountinfo
    fi
    have df || return 1
    # -l: local filesystems only (a stale NFS mount can never hang serverinfo)
    out=$(run_timeout 5 df -PTlB1 2>/dev/null)
    while read -r src type size used avail _ mnt; do
        if ! is_uint "$size" || ! is_uint "$used" || ! is_uint "$avail" || (( size == 0 )); then
            continue
        fi
        clean "$src"; src=$REPLY
        clean "$mnt"; mnt=$REPLY
        if [[ $mnt == / ]]; then
            ROOT_SRC=$src ROOT_FSTYPE=$type ROOT_SIZE=$size ROOT_USED=$used ROOT_AVAIL=$avail
            pct_x10 "$used" $(( used + avail ))
            ROOT_PCT_X10=$REPLY
            continue
        fi
        case $type in
            tmpfs|devtmpfs|overlay|squashfs|efivarfs|ramfs|nsfs|autofs|iso9660|udf|fuse.lxcfs|fuse.snapfuse) continue ;;
        esac
        case $mnt in
            /snap/*|/var/lib/docker/*|/var/lib/containers/*|/run/*|/proc/*|/sys/*|/dev/*) continue ;;
        esac
        # read-only mounts cannot fill up; bind mounts / btrfs subvolumes are duplicates
        [[ ${ro[$mnt]:-0} == 1 ]] && continue
        pct_x10 "$used" $(( used + avail ))
        entry="$mnt$FS_SEP$type$FS_SEP$size$FS_SEP$used$FS_SEP$avail$FS_SEP$REPLY$FS_SEP$src"
        [[ $src == /* && -n ${seen[$src]:-} ]] && continue
        seen[$src]=1
        FS_LIST+=("$entry")
    done <<< "$out"

    DISK_WORST_PCT_X10=$ROOT_PCT_X10 DISK_WORST_MOUNT="/"
    local -a f
    for entry in "${FS_LIST[@]}"; do
        IFS=$FS_SEP read -r -a f <<< "$entry"
        if (( f[5] > DISK_WORST_PCT_X10 )); then
            DISK_WORST_PCT_X10=${f[5]}
            DISK_WORST_MOUNT=${f[0]}
        fi
    done
    get_root_device_kind
}

# resolve_physical_disks NAME DEPTH - walk dm/md/partition layers down to disks
resolve_physical_disks() {
    local n=$1 depth=$2 s real parent lvl uuid x
    local sys=/sys/class/block/$n
    (( depth > 8 )) && return
    [[ -e $sys ]] || return
    local -a slaves=("$sys"/slaves/*)
    if (( ${#slaves[@]} > 0 )); then
        if [[ $n == md* ]] && read_first lvl "$sys/md/level"; then
            [[ -z $RESOLVED_RAID ]] && RESOLVED_RAID=${lvl^^}
        elif [[ $n == dm-* ]] && read_first uuid "$sys/dm/uuid"; then
            case $uuid in
                LVM-*) RESOLVED_LVM=1 ;;
                CRYPT-*) RESOLVED_CRYPT=1 ;;
            esac
        fi
        for s in "${slaves[@]}"; do
            resolve_physical_disks "${s##*/}" $(( depth + 1 ))
        done
        return
    fi
    if [[ -e $sys/partition ]]; then
        real=$(readlink -f "$sys" 2>/dev/null)
        parent=${real%/*}
        parent=${parent##*/}
        if [[ -n $parent && $parent != "$n" && -e /sys/block/$parent ]]; then
            # recurse: the parent may be stacked itself (md0p1 -> md0 -> member disks)
            resolve_physical_disks "$parent" $(( depth + 1 ))
            return
        fi
    fi
    [[ -e /sys/block/$n ]] || return
    for x in "${RESOLVED_DISKS[@]}"; do
        [[ $x == "$n" ]] && return
    done
    RESOLVED_DISKS+=("$n")
}

# get_root_device_kind - NVMe SSD / SSD / HDD / Virtual Disk (+ RAID/LVM layout)
get_root_device_kind() {
    local majmin=$ROOT_MAJMIN name="" real d rota model nvme=0 ssd=0 hdd=0 virt=0 virt_ssd=0 n
    local -a layout=()
    ROOT_KIND="" ROOT_MODEL="" ROOT_LAYOUT=""
    RESOLVED_DISKS=() RESOLVED_RAID="" RESOLVED_LVM=0 RESOLVED_CRYPT=0
    if [[ -n $majmin && -e /sys/dev/block/$majmin ]]; then
        real=$(readlink -f "/sys/dev/block/$majmin" 2>/dev/null)
        name=${real##*/}
    elif [[ $ROOT_SRC == /dev/* ]]; then
        real=$(readlink -f "$ROOT_SRC" 2>/dev/null)
        name=${real##*/}
    fi
    [[ -n $name ]] && resolve_physical_disks "$name" 0

    n=${#RESOLVED_DISKS[@]}
    if (( n == 0 )); then
        case $ROOT_FSTYPE in
            overlay) ROOT_KIND="Overlay (container)" ;;
            zfs) ROOT_KIND="ZFS pool" ;;
            btrfs) ROOT_KIND="Btrfs volume" ;;
            nfs*|cifs|ceph|glusterfs) ROOT_KIND="Network storage" ;;
            *) ROOT_KIND="N/A" ;;
        esac
        return
    fi
    for d in "${RESOLVED_DISKS[@]}"; do
        rota=1
        read_first rota "/sys/block/$d/queue/rotational"
        model=""
        read_first model "/sys/block/$d/device/model"
        clean "$model"
        model=$REPLY
        [[ -z $ROOT_MODEL && -n $model ]] && ROOT_MODEL=$model
        case ${model,,} in
            *qemu*|*vbox*|*virtual*|*vmware*|*msft*|*"elastic block store"*|*persistentdisk*)
                virt=$(( virt + 1 )); [[ $rota == 0 ]] && virt_ssd=$(( virt_ssd + 1 )); continue ;;
        esac
        case $d in
            nvme*) nvme=$(( nvme + 1 )) ;;
            vd*|xvd*) virt=$(( virt + 1 )); [[ $rota == 0 ]] && virt_ssd=$(( virt_ssd + 1 )) ;;
            *)
                if [[ $rota == 0 ]]; then
                    ssd=$(( ssd + 1 ))
                elif is_virtual_machine; then
                    virt=$(( virt + 1 ))   # hypervisors report rotational=1 by default
                else
                    hdd=$(( hdd + 1 ))
                fi
                ;;
        esac
    done
    if (( nvme == n )); then ROOT_KIND="NVMe SSD"
    elif (( ssd == n )); then ROOT_KIND="SSD"
    elif (( hdd == n )); then ROOT_KIND="HDD"
    elif (( virt == n && virt_ssd == n )); then ROOT_KIND="Virtual SSD"
    elif (( virt == n )); then ROOT_KIND="Virtual Disk"
    else
        local -a kinds=()
        (( nvme )) && kinds+=("NVMe")
        (( ssd )) && kinds+=("SSD")
        (( hdd )) && kinds+=("HDD")
        (( virt )) && kinds+=("Virtual")
        ROOT_KIND="Mixed (${kinds[*]})"
        ROOT_KIND=${ROOT_KIND// /+}
        ROOT_KIND=${ROOT_KIND/Mixed+/Mixed }
    fi
    [[ -n $RESOLVED_RAID ]] && layout+=("$RESOLVED_RAID")
    (( n > 1 )) && layout+=("$n disks")
    (( RESOLVED_LVM )) && layout+=("LVM")
    (( RESOLVED_CRYPT )) && layout+=("LUKS")
    local IFS=$'\x1e'
    ROOT_LAYOUT="${layout[*]}"
    ROOT_LAYOUT=${ROOT_LAYOUT//$'\x1e'/ · }
}

# fs_usage_of PATH -> REPLY ("33.0% used · 1.2 TiB free (/srv)")
# Asks df about the path itself, so bind mounts (which df lists only once per
# device) resolve to the right filesystem.
fs_usage_of() {
    local out size used avail mnt pct free
    REPLY="N/A"
    have df || return 1
    out=$(run_timeout 3 df -PB1 -- "$1" 2>/dev/null)
    [[ $out == *$'\n'* ]] || return 1
    read -r _ size used avail _ mnt <<< "${out#*$'\n'}"
    is_uint "$size" && is_uint "$used" && is_uint "$avail" || return 1
    pct_x10 "$used" $(( used + avail ))
    pct=$REPLY
    human_bytes "$avail"
    free=$REPLY
    clean "$mnt"
    mnt=$REPLY
    fmt_x10 "$pct"
    REPLY="$REPLY% used · $free free ($mnt)"
}

# ============================================================================
# NETWORK
# ============================================================================
NET_IFACE="" NET_IPV4="" NET_IPV4_EXTRA=0 NET_IPV6="" NET_PUBLIC_IP="" NET_PUBLIC_SRC=""
NET_GATEWAY="" NET_STATE="" NET_SPEED="" NET_MTU="" NET_RX=0 NET_TX=0 NET_DNS=""
NET_IPV4_CIDR="" NET_IPV4_ALL=() NET_DNS_LIST=()
NET_OTHER=()            # name<US>state<US>ipv4
declare -A NET_V4_FIRST=() NET_V4_LIST=()

# hex_to_ipv4 HEX (little-endian, /proc/net/route) -> REPLY
hex_to_ipv4() {
    [[ $1 =~ ^[0-9A-Fa-f]{8}$ ]] || return 1
    local h=$1
    REPLY="$(( 16#${h:6:2} )).$(( 16#${h:4:2} )).$(( 16#${h:2:2} )).$(( 16#${h:0:2} ))"
}

# format_ipv6 HEX32 -> REPLY (RFC 5952 compressed notation)
format_ipv6() {
    local h=$1 i g best_s=-1 best_l=0 cur_s=-1 cur_l=0 left="" right=""
    local -a gr=()
    [[ $h =~ ^[0-9a-fA-F]{32}$ ]] || return 1
    for (( i = 0; i < 32; i += 4 )); do
        printf -v g '%x' $(( 16#${h:i:4} ))
        gr+=("$g")
    done
    for (( i = 0; i < 8; i++ )); do
        if [[ ${gr[i]} == 0 ]]; then
            (( cur_s < 0 )) && cur_s=$i
            cur_l=$(( cur_l + 1 ))
            (( cur_l > best_l )) && { best_s=$cur_s; best_l=$cur_l; }
        else
            cur_s=-1 cur_l=0
        fi
    done
    if (( best_l >= 2 )); then
        for (( i = 0; i < best_s; i++ )); do left+="${left:+:}${gr[i]}"; done
        for (( i = best_s + best_l; i < 8; i++ )); do right+="${right:+:}${gr[i]}"; done
        REPLY="$left::$right"
    else
        local IFS=:
        REPLY="${gr[*]}"
    fi
}

is_public_ipv4() {
    local a b c d
    IFS=. read -r a b c d <<< "$1"
    is_uint "$a" && is_uint "$b" && is_uint "$c" && is_uint "$d" || return 1
    (( a == 0 || a == 10 || a == 127 || a >= 224 )) && return 1
    (( a == 100 && b >= 64 && b <= 127 )) && return 1
    (( a == 169 && b == 254 )) && return 1
    (( a == 172 && b >= 16 && b <= 31 )) && return 1
    (( a == 192 && b == 168 )) && return 1
    (( a == 192 && b == 0 && (c == 0 || c == 2) )) && return 1
    (( a == 198 && (b == 18 || b == 19) )) && return 1
    (( a == 198 && b == 51 && c == 100 )) && return 1
    (( a == 203 && b == 0 && c == 113 )) && return 1
    return 0
}

get_network_info() {
    local iface dest gw metric mask best=-1 dev st
    NET_IFACE="" NET_GATEWAY=""
    if [[ -r /proc/net/route ]]; then
        while read -r iface dest gw _ _ _ metric mask _; do
            [[ $dest == 00000000 && $mask == 00000000 ]] || continue
            is_uint "$metric" || metric=0
            if (( best < 0 || metric < best )); then
                best=$metric NET_IFACE=$iface NET_GATEWAY=$gw
            fi
        done < /proc/net/route
    fi
    if [[ -n $NET_GATEWAY ]] && hex_to_ipv4 "$NET_GATEWAY" && [[ $REPLY != 0.0.0.0 ]]; then
        NET_GATEWAY=$REPLY
    else
        NET_GATEWAY=""
    fi
    if [[ -z $NET_IFACE && -r /proc/net/ipv6_route ]]; then
        local d6 p6 if6
        while read -r d6 p6 _ _ _ _ _ _ _ if6; do
            if [[ $d6 == 00000000000000000000000000000000 && $p6 == 00 && $if6 != lo ]]; then
                NET_IFACE=$if6
                break
            fi
        done < /proc/net/ipv6_route
    fi
    if [[ -z $NET_IFACE ]]; then
        for dev in /sys/class/net/*; do
            dev=${dev##*/}
            case $dev in lo|docker*|veth*|br-*|pterodactyl*|virbr*|tun*|tap*|wg*) continue ;; esac
            if read_first st "/sys/class/net/$dev/operstate" && [[ $st == up ]]; then
                NET_IFACE=$dev
                break
            fi
        done
    fi

    # IPv4 addresses of all interfaces with a single `ip` call
    NET_V4_FIRST=() NET_V4_LIST=()
    local fam addr
    if have ip; then
        while read -r _ dev fam addr _; do
            [[ $fam == inet && $addr =~ ^[0-9.]+/[0-9]+$ ]] || continue
            dev=${dev%%@*}
            [[ -z ${NET_V4_FIRST[$dev]:-} ]] && NET_V4_FIRST[$dev]=$addr
            NET_V4_LIST[$dev]+="$addr "
        done < <(run_timeout 3 ip -4 -o addr show 2>/dev/null)
    fi

    [[ -n $NET_IFACE ]] || return 1
    clean "$NET_IFACE"
    NET_IFACE=$REPLY
    local base=/sys/class/net/$NET_IFACE speed=""
    NET_STATE="" NET_MTU="" NET_SPEED=""
    read_first NET_STATE "$base/operstate"
    read_first NET_MTU "$base/mtu"
    if read_first speed "$base/speed" && is_uint "$speed" && (( speed > 0 )); then
        if (( speed >= 1000 && speed % 1000 == 0 )); then
            NET_SPEED="$(( speed / 1000 )) Gbit/s"
        elif (( speed >= 1000 )); then
            NET_SPEED="$(( speed / 1000 )).$(( speed % 1000 / 100 )) Gbit/s"
        else
            NET_SPEED="$speed Mbit/s"
        fi
    fi
    read_first NET_RX "$base/statistics/rx_bytes" && is_uint "$NET_RX" || NET_RX=0
    read_first NET_TX "$base/statistics/tx_bytes" && is_uint "$NET_TX" || NET_TX=0

    local -a cidrs=()
    read -r -a cidrs <<< "${NET_V4_LIST[$NET_IFACE]:-}"
    if (( ${#cidrs[@]} == 0 )) && ! have ip && have hostname; then
        # without iproute2: all non-loopback IPv4 addresses of the host
        for addr in $(hostname -I 2>/dev/null); do
            [[ $addr =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]] && cidrs+=("$addr")
        done
    fi
    NET_IPV4_CIDR=${cidrs[0]:-}
    NET_IPV4=${NET_IPV4_CIDR%/*}
    NET_IPV4_ALL=("${cidrs[@]%/*}")
    NET_IPV4_EXTRA=0
    (( ${#cidrs[@]} > 1 )) && NET_IPV4_EXTRA=$(( ${#cidrs[@]} - 1 ))

    # IPv6: first stable global address (skip temporary / deprecated)
    local a plen scope fl name
    NET_IPV6=""
    if [[ -r /proc/net/if_inet6 ]]; then
        while read -r a _ plen scope fl name; do
            [[ $name == "$NET_IFACE" && $scope == 00 ]] || continue
            (( 16#$fl & 0x21 )) && continue
            format_ipv6 "$a" && { NET_IPV6="$REPLY/$(( 16#$plen ))"; break; }
        done < /proc/net/if_inet6
    fi
    get_dns_servers
    get_public_ip
}

get_dns_servers() {
    local key val rest file=/etc/resolv.conf
    local -a dns=()
    if [[ -r /run/systemd/resolve/resolv.conf ]] && grep -q '^nameserver 127\.0\.0\.53' "$file" 2>/dev/null; then
        file=/run/systemd/resolve/resolv.conf   # show real upstreams instead of the stub
    fi
    if [[ -r $file ]]; then
        while read -r key val rest; do
            [[ $key == nameserver && -n $val ]] && dns+=("$val")
        done < "$file"
    fi
    NET_DNS_LIST=()
    for key in "${dns[@]:0:3}"; do
        clean "$key"
        [[ -n $REPLY ]] && NET_DNS_LIST+=("$REPLY")
    done
    local IFS=,
    NET_DNS="${NET_DNS_LIST[*]}"
    NET_DNS=${NET_DNS//,/, }
}

get_public_ip() {
    local ip out
    NET_PUBLIC_IP="" NET_PUBLIC_SRC=""
    for ip in "${NET_IPV4_ALL[@]}"; do
        if is_public_ipv4 "$ip"; then
            NET_PUBLIC_IP=$ip NET_PUBLIC_SRC="interface"
            return 0
        fi
    done
    [[ $CFG_PUBLIC_IP_LOOKUP == yes ]] && have curl || return 1
    out=$(run_timeout 5 curl -q -fsS --max-time 3 --connect-timeout 2 --proto '=https' "$CFG_PUBLIC_IP_URL" 2>/dev/null) || return 1
    trim "$out"
    if [[ $REPLY =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}$ ]]; then
        NET_PUBLIC_IP=$REPLY NET_PUBLIC_SRC="lookup"
    fi
}

get_other_interfaces() {
    local dev st
    NET_OTHER=()
    for dev in /sys/class/net/*; do
        dev=${dev##*/}
        [[ $dev == lo || $dev == veth* || $dev == "$NET_IFACE" ]] && continue
        st=""
        read_first st "/sys/class/net/$dev/operstate"
        clean "$dev"
        NET_OTHER+=("$REPLY$FS_SEP${st:-unknown}$FS_SEP${NET_V4_FIRST[$dev]:-}")
    done
}

# ============================================================================
# SERVICES (systemd with a process-table fallback)
# ============================================================================
HAVE_SYSTEMD=0
declare -A SVC_LOAD=() SVC_ACTIVE=()

# query_services UNIT... - LoadState/ActiveState of all units in ONE systemctl call
query_services() {
    local -a units=("$@")
    local line i=0 unit
    SVC_LOAD=() SVC_ACTIVE=()
    HAVE_SYSTEMD=0
    [[ -d /run/systemd/system ]] && have systemctl && HAVE_SYSTEMD=1
    (( HAVE_SYSTEMD )) || return 1
    while IFS= read -r line; do
        if [[ -z $line ]]; then
            i=$(( i + 1 ))
            continue
        fi
        unit=${units[i]:-}
        [[ -n $unit ]] || continue
        case ${line%%=*} in
            LoadState) SVC_LOAD[$unit]=${line#*=} ;;
            ActiveState) SVC_ACTIVE[$unit]=${line#*=} ;;
        esac
    done < <(run_timeout 3 systemctl show --no-pager -p LoadState -p ActiveState "${units[@]/%/.service}" 2>/dev/null)
}

process_running() {
    local c comm
    if have pgrep; then
        pgrep -x "$1" >/dev/null 2>&1
        return
    fi
    for c in /proc/[0-9]*/comm; do
        read_first comm "$c" && [[ $comm == "$1" ]] && return 0
    done
    return 1
}

# service_state UNIT [PROCESS] -> REPLY: active | inactive | failed | activating | missing
service_state() {
    local unit=$1 proc=${2:-}
    if (( HAVE_SYSTEMD )) && [[ -n ${SVC_LOAD[$unit]:-} && ${SVC_LOAD[$unit]} != not-found ]]; then
        REPLY=${SVC_ACTIVE[$unit]:-inactive}
        return 0
    fi
    if [[ -n $proc ]] && process_running "$proc"; then
        REPLY=active
    elif (( HAVE_SYSTEMD )); then
        REPLY=missing
    else
        REPLY=inactive
    fi
}

# ============================================================================
# DOCKER
# ============================================================================
DOCKER_INSTALLED=0 DOCKER_ACCESS=0 DOCKER_STATE="NOT INSTALLED" DOCKER_VERSION=""
DOCKER_CONTAINERS="" DOCKER_RUNNING="" DOCKER_PAUSED="" DOCKER_STOPPED="" DOCKER_IMAGES=""
DOCKER_DRIVER="" DOCKER_ROOT=""

get_docker_info() {
    local out rc
    DOCKER_INSTALLED=0 DOCKER_ACCESS=0 DOCKER_STATE="NOT INSTALLED" DOCKER_VERSION=""
    DOCKER_CONTAINERS="" DOCKER_RUNNING="" DOCKER_PAUSED="" DOCKER_STOPPED="" DOCKER_IMAGES=""
    if ! have docker && ! have dockerd && [[ ${SVC_LOAD[docker]:-} != loaded ]]; then
        return 0
    fi
    DOCKER_INSTALLED=1
    DOCKER_STATE="STOPPED"
    # Never wake a socket-activated daemon (docker.socket): only talk to Docker
    # when the engine is already running.
    local running=0 v
    if (( HAVE_SYSTEMD )) && [[ ${SVC_LOAD[docker]:-} == loaded ]]; then
        case ${SVC_ACTIVE[docker]:-} in
            active|reloading) running=1 ;;
            activating) DOCKER_STATE="STARTING" ;;
        esac
    elif process_running dockerd; then
        running=1
    fi
    if (( running )) && have docker; then
        out=$(run_timeout 6 docker info --format '{{.ServerVersion}}|{{.Containers}}|{{.ContainersRunning}}|{{.ContainersPaused}}|{{.ContainersStopped}}|{{.Images}}|{{.Driver}}|{{.DockerRootDir}}' 2>/dev/null)
        rc=$?
        if (( rc == 0 )); then
            IFS='|' read -r DOCKER_VERSION DOCKER_CONTAINERS DOCKER_RUNNING DOCKER_PAUSED \
                DOCKER_STOPPED DOCKER_IMAGES DOCKER_DRIVER DOCKER_ROOT <<< "$out"
        fi
        # every count is validated: foreign strings are never evaluated arithmetically
        for v in DOCKER_CONTAINERS DOCKER_RUNNING DOCKER_PAUSED DOCKER_STOPPED DOCKER_IMAGES; do
            is_uint "${!v}" || printf -v "$v" '%s' ""
        done
        if (( rc == 0 )) && [[ -n $DOCKER_VERSION && -n $DOCKER_CONTAINERS ]]; then
            DOCKER_ACCESS=1 DOCKER_STATE="RUNNING"
            clean "$DOCKER_VERSION"; DOCKER_VERSION=$REPLY
            clean "$DOCKER_DRIVER"; DOCKER_DRIVER=$REPLY
            clean "$DOCKER_ROOT"; DOCKER_ROOT=$REPLY
            return 0
        fi
        DOCKER_VERSION="" DOCKER_CONTAINERS="" DOCKER_RUNNING="" DOCKER_PAUSED=""
        DOCKER_STOPPED="" DOCKER_IMAGES="" DOCKER_DRIVER="" DOCKER_ROOT=""
        if [[ -S /var/run/docker.sock && ! -w /var/run/docker.sock ]]; then
            DOCKER_STATE="NO ACCESS"
        else
            DOCKER_STATE="UNKNOWN"   # engine running but not answering
        fi
    fi
    if [[ -z $DOCKER_VERSION ]] && have docker; then
        # client version only - does not contact the daemon
        v=$(run_timeout 3 docker --version 2>/dev/null)
        [[ $v =~ ([0-9]+\.[0-9]+\.[0-9]+) ]] && DOCKER_VERSION=${BASH_REMATCH[1]}
    fi
}

# ============================================================================
# PTERODACTYL (detection only - this tool never installs or changes anything)
# ============================================================================
PTERO_DETECTED=0
PANEL_DETECTED=0 PANEL_PATH="" PANEL_VERSION="" PANEL_WEBSERVER="" PANEL_DB_OK=0
PANEL_SERVERS="" PANEL_NODES="" PANEL_SUSPENDED="" PANEL_NODE_SERVERS=""
WINGS_INSTALLED=0 WINGS_BIN="" WINGS_STATE="NOT INSTALLED" WINGS_VERSION=""
WINGS_NODE_UUID="" WINGS_API_HOST="" WINGS_API_PORT="" WINGS_API_TLS="" WINGS_API_CERT=""
WINGS_SFTP_PORT="" WINGS_ROOT_DIR="/var/lib/pterodactyl" WINGS_DATA_DIR="/var/lib/pterodactyl/volumes"
PTERO_SERVERS="" PTERO_ONLINE="" PTERO_OFFLINE="" PTERO_STARTING="" PTERO_SUSPENDED=""
PTERO_SOURCE="" PTERO_NOTE=""

# yaml_get FILE KEY.PATH... -> "path<TAB>value" lines. Minimal indentation-based
# reader, sufficient for Wings' config.yml (scalars only, lists are skipped).
yaml_get() {
    local file=$1
    shift
    awk -v want="$*" '
        BEGIN { n = split(want, w, " "); for (i = 1; i <= n; i++) wanted[w[i]] = 1 }
        {
            line = $0
            sub(/\r$/, "", line)
            if (line ~ /^[ \t]*#/ || line ~ /^[ \t]*$/ || line ~ /^[ \t]*-/) next
            match(line, /^ */)
            indent = RLENGTH
            rest = substr(line, indent + 1)
            if (rest !~ /^[A-Za-z0-9_.-]+[ \t]*:/) next
            key = rest
            sub(/[ \t]*:.*$/, "", key)
            val = rest
            sub(/^[^:]*:[ \t]*/, "", val)
            while (depth > 0 && ind[depth] >= indent) depth--
            depth++
            ind[depth] = indent
            keys[depth] = key
            path = keys[1]
            for (i = 2; i <= depth; i++) path = path "." keys[i]
            if (!(path in wanted)) next
            if (val ~ /^"/) { val = substr(val, 2); sub(/".*$/, "", val) }
            else if (val ~ /^\047/) { val = substr(val, 2); sub(/\047.*$/, "", val) }
            else { sub(/[ \t]+#.*$/, "", val); sub(/[ \t]+$/, "", val) }
            print path "\t" val
        }' "$file" 2>/dev/null
}

# read_dotenv CONTENT KEY -> REPLY  (Laravel .env; first definition wins, like phpdotenv)
read_dotenv() {
    local content=$1 key=$2 line val out="" i ch
    REPLY=""
    while IFS= read -r line || [[ -n $line ]]; do
        line=${line%$'\r'}
        [[ $line =~ ^[[:space:]]*(export[[:space:]]+)?([A-Za-z0-9_]+)[[:space:]]*=[[:space:]]*(.*)$ ]] || continue
        [[ ${BASH_REMATCH[2]} == "$key" ]] || continue
        val=${BASH_REMATCH[3]}
        if [[ $val == \"* ]]; then
            val=${val:1}
            for (( i = 0; i < ${#val}; i++ )); do
                ch=${val:i:1}
                if [[ $ch == \\ ]]; then
                    i=$(( i + 1 ))
                    out+=${val:i:1}
                elif [[ $ch == \" ]]; then
                    break
                else
                    out+=$ch
                fi
            done
            val=$out
        elif [[ $val == \'* ]]; then
            val=${val:1}
            val=${val%%\'*}
        else
            val=${val%%[[:space:]]#*}
            trim "$val"
            val=$REPLY
        fi
        REPLY=$val
        return 0
    done <<< "$content"
    return 1
}

detect_pterodactyl() {
    local dir c server path
    local -a candidates=() confs=()
    local -A from_web=()
    PANEL_DETECTED=0 PANEL_PATH="" PANEL_VERSION="" PANEL_WEBSERVER=""
    WINGS_INSTALLED=0 WINGS_BIN=""

    # ---- Wings: binary, config or systemd unit ----
    if have wings; then
        WINGS_BIN=$(command -v wings)
    elif [[ -x /usr/local/bin/wings ]]; then
        WINGS_BIN=/usr/local/bin/wings
    fi
    if [[ -n $WINGS_BIN || -f $CFG_WINGS_CONFIG || ${SVC_LOAD[wings]:-} == loaded ]]; then
        WINGS_INSTALLED=1
    fi

    # ---- Panel: known paths + web server document roots ending in /public ----
    [[ -n $CFG_PANEL_DIR ]] && candidates+=("$CFG_PANEL_DIR")
    candidates+=(/var/www/pterodactyl /var/www/html/pterodactyl /var/www/panel /var/www/html/panel /srv/pterodactyl /opt/pterodactyl)
    for c in /etc/nginx/sites-enabled/* /etc/nginx/conf.d/*.conf /etc/apache2/sites-enabled/*; do
        [[ -f $c && -r $c ]] && confs+=("$c")
    done
    if (( ${#confs[@]} > 0 )); then
        while IFS=$'\t' read -r server path; do
            [[ $path == /* ]] || continue
            candidates+=("$path")
            [[ -z ${from_web[$path]:-} ]] && from_web[$path]=$server
        done < <(awk '
            FNR == 1 { srv = (FILENAME ~ /apache2/) ? "apache2" : "nginx" }
            {
                k = tolower($1)
                if ((k == "root" || k == "documentroot") && NF >= 2) {
                    p = $2
                    gsub(/[";]/, "", p)
                    if (p ~ /\/public\/?$/) { sub(/\/public\/?$/, "", p); print srv "\t" p }
                }
            }' "${confs[@]}" 2>/dev/null)
    fi
    local re_composer='"name"[[:space:]]*:[[:space:]]*"pterodactyl/panel"'
    for dir in "${candidates[@]}"; do
        dir=${dir%/}
        [[ -d $dir && -f $dir/artisan ]] || continue
        if [[ -f $dir/config/pterodactyl.php ]] || { safe_read "$dir/composer.json" && [[ $REPLY =~ $re_composer ]]; }; then
            PANEL_DETECTED=1
            clean "$dir"; PANEL_PATH=$REPLY
            PANEL_WEBSERVER=${from_web[$dir]:-}
            break
        fi
    done
    local re_version="'version'[[:space:]]*=>[[:space:]]*'([A-Za-z0-9._-]{1,32})'"
    if (( PANEL_DETECTED )) && safe_read "$PANEL_PATH/config/app.php" 262144 && [[ $REPLY =~ $re_version ]]; then
        PANEL_VERSION=${BASH_REMATCH[1]}
    fi
    PTERO_DETECTED=0
    (( PANEL_DETECTED || WINGS_INSTALLED )) && PTERO_DETECTED=1
    return 0
}

# get_wings_status - power state via systemd (`systemctl is-active wings` semantics)
get_wings_status() {
    WINGS_STATE="NOT INSTALLED"
    (( WINGS_INSTALLED )) || return 0
    service_state wings wings
    case $REPLY in
        active|reloading) WINGS_STATE="ONLINE" ;;
        activating) WINGS_STATE="STARTING" ;;
        *) WINGS_STATE="OFFLINE" ;;
    esac
}

# get_wings_details - version and non-secret config metadata (static, read once)
get_wings_details() {
    local out path val
    WINGS_VERSION=""
    (( WINGS_INSTALLED )) || return 0
    if [[ -n $WINGS_BIN ]]; then
        # `wings version` only prints the version and exits
        out=$(run_timeout 3 "$WINGS_BIN" version </dev/null 2>/dev/null)
        [[ $out =~ v?([0-9]+\.[0-9]+\.[0-9]+[A-Za-z0-9.-]*) ]] && WINGS_VERSION=${BASH_REMATCH[1]}
    fi
    # Non-secret metadata only (the token is read separately, right before use)
    [[ -r $CFG_WINGS_CONFIG ]] || return 0
    while IFS=$'\t' read -r path val; do
        clean "$val"
        val=$REPLY
        case $path in
            uuid) [[ $val =~ ^[0-9a-fA-F-]{36}$ ]] && WINGS_NODE_UUID=$val ;;
            api.host) WINGS_API_HOST=$val ;;
            api.port) is_uint "$val" && WINGS_API_PORT=$val ;;
            api.ssl.enabled) WINGS_API_TLS=${val,,} ;;
            api.ssl.cert) WINGS_API_CERT=$val ;;
            system.root_directory) [[ $val == /* ]] && WINGS_ROOT_DIR=$val ;;
            system.data) [[ $val == /* ]] && WINGS_DATA_DIR=$val ;;
            system.sftp.bind_port) is_uint "$val" && WINGS_SFTP_PORT=$val ;;
        esac
    done < <(yaml_get "$CFG_WINGS_CONFIG" uuid api.host api.port api.ssl.enabled api.ssl.cert \
        system.root_directory system.data system.sftp.bind_port)
    [[ -n $WINGS_API_PORT ]] || WINGS_API_PORT=8080
}

# wings_listener_ok PORT IPV4 - true only when a ROOT-owned socket is listening on
# PORT (wildcard or IPV4). Guards the Wings token against a rogue unprivileged
# process that grabbed the port while Wings was down.
wings_listener_ok() {
    local port=$1 ip=$2 phex iphex a b c d f
    local -a files=()
    printf -v phex '%04X' "$port"
    IFS=. read -r a b c d <<< "$ip"
    printf -v iphex '%02X%02X%02X%02X' "$d" "$c" "$b" "$a"
    for f in /proc/net/tcp /proc/net/tcp6; do
        [[ -r $f ]] && files+=("$f")
    done
    (( ${#files[@]} > 0 )) || return 1
    awk -v p="$phex" -v v4="$iphex" '
        $4 == "0A" && $8 == 0 {
            split($2, x, ":")
            if (x[2] != p) next
            if (x[1] == "00000000" || x[1] == v4 || x[1] == "00000000000000000000000000000000" ||
                x[1] == "0000000000000000FFFF0000" v4) { found = 1; exit }
        }
        END { exit !found }' "${files[@]}" 2>/dev/null
}

# wings_tls_name CERT -> REPLY : a DNS name covered by the Wings certificate
wings_tls_name() {
    local cert=$1 out name=""
    REPLY=""
    if have openssl && [[ -r $cert ]]; then
        out=$(run_timeout 3 openssl x509 -in "$cert" -noout -ext subjectAltName 2>/dev/null)
        [[ $out =~ DNS:([A-Za-z0-9*.-]+) ]] && name=${BASH_REMATCH[1]}
        if [[ -z $name ]]; then
            out=$(run_timeout 3 openssl x509 -in "$cert" -noout -subject -nameopt multiline 2>/dev/null)
            [[ $out =~ commonName[[:space:]]*=[[:space:]]*([A-Za-z0-9*.-]+) ]] && name=${BASH_REMATCH[1]}
        fi
    fi
    if [[ -z $name && $cert =~ /live/([A-Za-z0-9.-]+)/[^/]+$ ]]; then
        name=${BASH_REMATCH[1]}
        [[ $name =~ ^(.+)-[0-9]{4}$ ]] && name=${BASH_REMATCH[1]}
    fi
    [[ $name == \*.* ]] && name="serverinfo.${name#\*.}"
    [[ $name =~ ^[A-Za-z0-9]([A-Za-z0-9.-]*[A-Za-z0-9])?$ && $name == *.* ]] || return 1
    REPLY=$name
}

# wings_api_request TOKEN URL [CURL ARGS...] -> stdout: "total running transitional suspended"
# The token reaches curl only through stdin (--config -); -q ignores any .curlrc and
# the connection is always direct (--noproxy: never via an HTTP(S)_PROXY). The raw response,
# which contains server environment variables, is consumed by jq and never shown.
wings_api_request() {
    local token=$1 url=$2
    shift 2
    printf 'header = "Authorization: Bearer %s"\nheader = "Accept: application/json"\n' "$token" \
        | run_timeout 7 curl -q --config - -fsS --noproxy '*' --max-time 6 --connect-timeout 2 --proto '=http,https' "$@" "$url" 2>/dev/null \
        | jq -r 'if type == "array" then [length,
                    (map(select(.state == "running")) | length),
                    (map(select(.state == "starting" or .state == "stopping")) | length),
                    (map(select(.is_suspended == true)) | length)] | @tsv
                 else empty end' 2>/dev/null
}

# wings_api_counts - live per-server power states from the local Wings API
wings_api_counts() {
    local host=${WINGS_API_HOST:-0.0.0.0} port=${WINGS_API_PORT:-8080} ip name url out path val token=""
    local total running trans susp
    local -a extra=()
    [[ $CFG_WINGS_API == off || $WINGS_STATE != ONLINE ]] && return 1
    [[ -r $CFG_WINGS_CONFIG ]] && have curl && have jq || return 1
    case $host in
        ""|0.0.0.0|::|"[::]"|127.0.0.1|localhost) ip=127.0.0.1 ;;
        *) [[ $host =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}$ ]] || return 1; ip=$host ;;
    esac
    wings_listener_ok "$port" "$ip" || return 1
    if [[ $WINGS_API_TLS == true ]]; then
        wings_tls_name "$WINGS_API_CERT" || return 1
        name=$REPLY
        url="https://$name:$port/api/servers"
        extra=(--resolve "$name:$port:$ip")
    else
        url="http://$ip:$port/api/servers"
    fi
    while IFS=$'\t' read -r path val; do
        [[ $path == token ]] && token=$val
    done < <(yaml_get "$CFG_WINGS_CONFIG" token)
    if ! [[ $token =~ ^[A-Za-z0-9._-]{16,512}$ ]]; then
        token=""
        return 1
    fi
    out=$(wings_api_request "$token" "$url" "${extra[@]}")
    if [[ -z $out && $WINGS_API_TLS == true && -r $WINGS_API_CERT ]]; then
        out=$(wings_api_request "$token" "$url" "${extra[@]}" --cacert "$WINGS_API_CERT")   # self-signed
    fi
    token=""
    IFS=$'\t' read -r total running trans susp <<< "$out"
    is_uint "$total" && is_uint "$running" && is_uint "$trans" && is_uint "$susp" || return 1
    PTERO_SERVERS=$total PTERO_ONLINE=$running PTERO_STARTING=$trans PTERO_SUSPENDED=$susp
    PTERO_OFFLINE=$(( total - running - trans ))
    PTERO_SOURCE="Wings API"
}

# docker_ptero_counts - Wings server containers (labels set by Wings) merged with
# the server list Wings persists every minute in states.json
docker_ptero_counts() {
    local out name status states content re
    local -A servers=() running=()
    (( DOCKER_ACCESS )) || return 1
    out=$(run_timeout 6 docker ps -a --no-trunc \
        --filter "label=Service=Pterodactyl" --filter "label=ContainerType=server_process" \
        --format '{{.Names}}	{{.Status}}' 2>/dev/null) || return 1
    while IFS=$'\t' read -r name status; do
        [[ -n $name ]] || continue
        name=${name#/}
        servers[$name]=1
        [[ $status == Up* && $status != *"(Paused)"* ]] && running[$name]=1
    done <<< "$out"
    states="$WINGS_ROOT_DIR/states.json"
    if [[ -f $states && -r $states ]]; then
        content=$(< "$states")
        re='"([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})"[[:space:]]*:'
        while [[ $content =~ $re ]]; do
            servers[${BASH_REMATCH[1]}]=1
            content=${content#*"${BASH_REMATCH[0]}"}
        done
    fi
    PTERO_SERVERS=${#servers[@]} PTERO_ONLINE=${#running[@]} PTERO_STARTING="" PTERO_SUSPENDED=""
    PTERO_OFFLINE=$(( PTERO_SERVERS - PTERO_ONLINE ))
    PTERO_SOURCE="Docker"
}

# panel_db_counts - server/node totals from the panel database (read-only COUNT
# queries). Credentials are parsed from .env, validated, and passed to the
# client through an anonymous pipe (fd 3) - never argv, env or output.
panel_db_counts() {
    local env_file="$PANEL_PATH/.env" env="" client="" conn host port db user pass prefix q out
    local a b c d
    local re_host='^[A-Za-z0-9._:-]+$' re_port='^[0-9]{1,5}$' re_db='^[A-Za-z0-9_][A-Za-z0-9_$-]*$' re_prefix='^[A-Za-z0-9_]*$'
    [[ $CFG_PANEL_DATABASE == off ]] && return 1
    if have mariadb; then client=mariadb; elif have mysql; then client=mysql; else return 1; fi
    # .env is owned by www-data: one bounded read, then parsed from memory
    safe_read "$env_file" 65536 || return 1
    env=$REPLY
    read_dotenv "$env" DB_CONNECTION; conn=${REPLY:-mysql}
    read_dotenv "$env" DB_HOST;     host=${REPLY:-127.0.0.1}
    read_dotenv "$env" DB_PORT;     port=${REPLY:-3306}
    read_dotenv "$env" DB_DATABASE; db=${REPLY:-panel}
    read_dotenv "$env" DB_USERNAME; user=${REPLY:-pterodactyl}
    read_dotenv "$env" DB_PASSWORD; pass=$REPLY
    read_dotenv "$env" DB_PREFIX;   prefix=$REPLY
    env="" REPLY=""
    if ! [[ ($conn == mysql || $conn == mariadb) && $host =~ $re_host && $port =~ $re_port && $db =~ $re_db && $prefix =~ $re_prefix ]] \
        || [[ $user == *[$'\n\r']* || $pass == *[$'\n\r']* ]]; then
        pass=""
        return 1
    fi
    user=${user//\\/\\\\}; user=${user//\"/\\\"}
    pass=${pass//\\/\\\\}; pass=${pass//\"/\\\"}
    q="SELECT (SELECT COUNT(*) FROM \`${prefix}servers\`), (SELECT COUNT(*) FROM \`${prefix}nodes\`),"
    q+=" (SELECT COUNT(*) FROM \`${prefix}servers\` WHERE status = 'suspended'),"
    if [[ -n $WINGS_NODE_UUID ]]; then
        q+=" (SELECT COUNT(*) FROM \`${prefix}servers\` s JOIN \`${prefix}nodes\` n ON n.id = s.node_id WHERE n.uuid = '$WINGS_NODE_UUID')"
    else
        q+=" NULL"
    fi
    # Credentials travel through an anonymous pipe (fd 3), never argv/env.
    # --defaults-file: no other option file (~/.my.cnf, /etc/mysql) can override them.
    # --local-infile=0: a rogue server (DB_HOST comes from a www-data owned file)
    # can never request local files from this root process.
    out=$(run_timeout 6 "$client" --defaults-file=/dev/fd/3 --local-infile=0 --connect-timeout=3 -N -B -s -e "$q" 3< <(
        printf '[client]\nuser="%s"\npassword="%s"\nhost="%s"\nport=%s\ndatabase="%s"\n' "$user" "$pass" "$host" "$port" "$db"
    ) 2>/dev/null)
    pass="" user=""
    IFS=$'\t' read -r a b c d <<< "$out"
    is_uint "$a" && is_uint "$b" && is_uint "$c" || return 1
    PANEL_SERVERS=$a PANEL_NODES=$b PANEL_SUSPENDED=$c PANEL_NODE_SERVERS=""
    is_uint "$d" && PANEL_NODE_SERVERS=$d
    PANEL_DB_OK=1
}

# get_pterodactyl_info [refresh] - "refresh" skips the static detection (live mode)
get_pterodactyl_info() {
    PTERO_SERVERS="" PTERO_ONLINE="" PTERO_OFFLINE="" PTERO_STARTING="" PTERO_SUSPENDED=""
    PTERO_SOURCE="" PTERO_NOTE="" PANEL_DB_OK=0 PANEL_NODE_SERVERS=""
    if [[ ${1:-} != refresh ]]; then
        detect_pterodactyl
        get_wings_details
    fi
    get_wings_status
    (( PTERO_DETECTED )) || return 0
    (( PANEL_DETECTED )) && panel_db_counts

    if (( WINGS_INSTALLED )); then
        # Priority: live Wings API -> Docker containers (+ panel DB total) -> N/A
        if ! wings_api_counts && docker_ptero_counts; then
            if [[ -n $PANEL_NODE_SERVERS ]] && (( PANEL_NODE_SERVERS >= PTERO_ONLINE )); then
                PTERO_SERVERS=$PANEL_NODE_SERVERS
                PTERO_OFFLINE=$(( PTERO_SERVERS - PTERO_ONLINE ))
                PTERO_SOURCE="Docker + Panel DB"
            fi
        fi
        if [[ -z $PTERO_SOURCE ]]; then
            if (( EUID != 0 )); then
                PTERO_NOTE="run as root to count servers"
            elif (( ! DOCKER_ACCESS )); then
                PTERO_NOTE="Wings API and Docker unavailable"
            fi
        fi
    elif (( PANEL_DB_OK )); then
        # Panel-only host: totals come from the database; power state lives on the nodes
        PTERO_SERVERS=$PANEL_SERVERS PTERO_SUSPENDED=$PANEL_SUSPENDED
        PTERO_SOURCE="Panel DB"
        PTERO_NOTE="power state is tracked by the Wings nodes"
    elif (( EUID != 0 )); then
        PTERO_NOTE="run as root to count servers"
    fi
}

# ============================================================================
# HEALTH
# ============================================================================
HEALTH_CPU="" HEALTH_RAM="" HEALTH_DISK="" HEALTH_WINGS="" HEALTH_DOCKER=""
HEALTH_PTERO="" HEALTH_OVERALL=""

# threshold_state PCT_X10 WARN CRIT CRIT_WORD -> REPLY
threshold_state() {
    if (( $1 >= $3 * 10 )); then
        REPLY=$4
    elif (( $1 >= $2 * 10 )); then
        REPLY=WARNING
    else
        REPLY=HEALTHY
    fi
}

get_health_status() {
    local level=0 s
    threshold_state "${CPU_USAGE_X10:-0}" "$CFG_CPU_WARN" "$CFG_CPU_CRIT" HIGH
    HEALTH_CPU=$REPLY
    threshold_state "$MEM_PCT_X10" "$CFG_RAM_WARN" "$CFG_RAM_CRIT" CRITICAL
    HEALTH_RAM=$REPLY
    threshold_state "$DISK_WORST_PCT_X10" "$CFG_DISK_WARN" "$CFG_DISK_CRIT" CRITICAL
    HEALTH_DISK=$REPLY
    HEALTH_WINGS=$WINGS_STATE
    HEALTH_DOCKER=$DOCKER_STATE
    if (( PTERO_DETECTED )); then HEALTH_PTERO="DETECTED"; else HEALTH_PTERO="NOT DETECTED"; fi

    for s in "$HEALTH_CPU" "$HEALTH_RAM" "$HEALTH_DISK"; do
        case $s in
            WARNING) (( level < 1 )) && level=1 ;;
            HIGH|CRITICAL) level=2 ;;
        esac
    done
    [[ $WINGS_STATE == OFFLINE ]] && level=2
    if (( WINGS_INSTALLED )); then
        case $DOCKER_STATE in
            STOPPED|UNKNOWN|"NOT INSTALLED") level=2 ;;
            STARTING) (( level < 1 )) && level=1 ;;
        esac
    fi
    case $level in
        0) HEALTH_OVERALL="HEALTHY" ;;
        1) HEALTH_OVERALL="WARNING" ;;
        *) HEALTH_OVERALL="CRITICAL" ;;
    esac
}

